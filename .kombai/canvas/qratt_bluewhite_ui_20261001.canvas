      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#F3F7FC] px-8 py-8 text-[#14233A]\" data-kid=\"1\" style=\"font-family:'DM Sans',sans-serif\">\n    <header class=\"rounded-[28px] bg-[#0A2047] px-9 py-7 text-white shadow-[0_18px_40px_-18px_rgba(10,32,71,0.34)]\" data-kid=\"1-1\">\n        <div class=\"flex items-start justify-between gap-8\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\">\n                <img alt=\"QR-ATT app icon\" class=\"h-14 w-14 rounded-2xl border border-white/15 object-cover\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[#B8CBE7]\" data-kid=\"1-1-1-1-2-1\">\n                        QR-ATT · Product UI direction\n                    </p>\n                    <h1 class=\"mt-1 text-[30px] font-extrabold tracking-[-0.045em]\" data-kid=\"1-1-1-1-2-2\" style=\"font-family:'Manrope',sans-serif\">\n                        Dark navy. Clear white.\n                    </h1>\n                    <p class=\"mt-1 max-w-[720px] text-[14px] text-[#D4E0F1]\" data-kid=\"1-1-1-1-2-3\">\n                        A calmer, more coherent attendance flow—from sign-in to event check-in and teacher roll call.\n                    </p>\n                </div>\n            </div>\n            <div class=\"shrink-0 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-[11px] font-semibold tracking-[0.08em] text-[#EAF1FB]\" data-kid=\"1-1-1-2\">\n                WHITE-FIRST SURFACES · MOBILE\n            </div>\n        </div>\n    </header>\n    <section aria-label=\"Design tokens and shared components\" class=\"mt-5 grid grid-cols-[1.2fr_1fr_1.45fr] gap-4\" data-kid=\"1-2\">\n        <div class=\"rounded-2xl border border-[#DCE5F0] bg-white p-4\" data-kid=\"1-2-1\">\n            <div class=\"mb-3 text-[10px] font-bold uppercase tracking-[0.14em] text-[#60718A]\" data-kid=\"1-2-1-1\">\n                Palette\n            </div>\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-2\">\n                <div class=\"flex-1\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"h-7 rounded-lg bg-[#0A2047]\" data-kid=\"1-2-1-2-1-1\">\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold text-[#43536A]\" data-kid=\"1-2-1-2-1-2\">\n                        Navy\n                    </div>\n                </div>\n                <div class=\"flex-1\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"h-7 rounded-lg bg-[#153E78]\" data-kid=\"1-2-1-2-2-1\">\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold text-[#43536A]\" data-kid=\"1-2-1-2-2-2\">\n                        Action blue\n                    </div>\n                </div>\n                <div class=\"flex-1\" data-kid=\"1-2-1-2-3\">\n                    <div class=\"h-7 rounded-lg border border-[#DCE5F0] bg-white\" data-kid=\"1-2-1-2-3-1\">\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold text-[#43536A]\" data-kid=\"1-2-1-2-3-2\">\n                        White\n                    </div>\n                </div>\n                <div class=\"flex-1\" data-kid=\"1-2-1-2-4\">\n                    <div class=\"h-7 rounded-lg border border-[#DCE5F0] bg-[#F3F7FC]\" data-kid=\"1-2-1-2-4-1\">\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold text-[#43536A]\" data-kid=\"1-2-1-2-4-2\">\n                        Cool mist\n                    </div>\n                </div>\n                <div class=\"flex-1\" data-kid=\"1-2-1-2-5\">\n                    <div class=\"h-7 rounded-lg bg-[#E8F0FA]\" data-kid=\"1-2-1-2-5-1\">\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold text-[#43536A]\" data-kid=\"1-2-1-2-5-2\">\n                        Support\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"rounded-2xl border border-[#DCE5F0] bg-white p-4\" data-kid=\"1-2-2\">\n            <div class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-[#60718A]\" data-kid=\"1-2-2-1\">\n                Type roles\n            </div>\n            <div class=\"text-[20px] font-extrabold tracking-[-0.04em] text-[#0A2047]\" data-kid=\"1-2-2-2\" style=\"font-family:'Manrope',sans-serif\">\n                Manrope · headings\n            </div>\n            <div class=\"mt-1 text-[12px] leading-[17px] text-[#52647C]\" data-kid=\"1-2-2-3\">\n                DM Sans · form labels, guidance, data\n            </div>\n            <div class=\"mt-2 text-[10px] text-[#76859A]\" data-kid=\"1-2-2-4\">\n                Consistent sentence-case labels · readable event times\n            </div>\n        </div>\n        <div class=\"rounded-2xl border border-[#DCE5F0] bg-white p-4\" data-kid=\"1-2-3\">\n            <div class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-[#60718A]\" data-kid=\"1-2-3-1\">\n                Shared action states\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-2\">\n                <div class=\"rounded-xl bg-[#153E78] px-3.5 py-2.5 text-[11px] font-bold text-white\" data-kid=\"1-2-3-2-1\">\n                    <i class=\"ti ti-arrow-right mr-1 text-[13px]\" data-kid=\"1-2-3-2-1-1\" style=\"color:#fff\">\n                    </i>\n                    Primary\n                </div>\n                <div class=\"rounded-xl border border-[#D6E1EE] bg-white px-3.5 py-2.5 text-[11px] font-bold text-[#18365F]\" data-kid=\"1-2-3-2-2\" data-name=\"secondary action button\">\n                    <i class=\"ti ti-history mr-1 text-[13px]\" data-kid=\"1-2-3-2-2-1\" style=\"color:#18365F\">\n                    </i>\n                    Secondary\n                </div>\n                <div class=\"rounded-xl bg-[#E9EDF3] px-3.5 py-2.5 text-[11px] font-bold text-[#78869A]\" data-kid=\"1-2-3-2-3\">\n                    <i class=\"ti ti-loader-2 mr-1 text-[13px]\" data-kid=\"1-2-3-2-3-1\" style=\"color:#78869A\">\n                    </i>\n                    Loading\n                </div>\n                <div class=\"rounded-xl border border-[#D9E0E9] bg-[#F1F4F8] px-3.5 py-2.5 text-[11px] font-semibold text-[#8290A2]\" data-kid=\"1-2-3-2-4\">\n                    Disabled\n                </div>\n                <span class=\"ml-auto text-[10px] text-[#748197]\" data-kid=\"1-2-3-2-5\">\n                    Success\n                    <b class=\"text-[#187252]\" data-kid=\"1-2-3-2-5-1\">\n                        #187252\n                    </b>\n                    · Error\n                    <b class=\"text-[#B3261E]\" data-kid=\"1-2-3-2-5-2\" data-name=\"error color code text\">\n                        #B3261E\n                    </b>\n                </span>\n            </div>\n        </div>\n    </section>\n    <div class=\"mt-7 mb-3 flex items-end justify-between\" data-kid=\"1-3\">\n        <div data-kid=\"1-3-1\">\n            <h2 class=\"text-[21px] font-extrabold tracking-[-0.03em] text-[#0A2047]\" data-kid=\"1-3-1-1\" style=\"font-family:'Manrope',sans-serif\">\n                Seven screens. One attendance workflow.\n            </h2>\n            <p class=\"mt-1 text-[12px] text-[#60718A]\" data-kid=\"1-3-1-2\">\n                The familiar routes remain; emphasis, feedback, and wayfinding now work as a single system.\n            </p>\n        </div>\n        <div class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#7A8AA0]\" data-kid=\"1-3-2\">\n            4 screens · then 3 screens\n        </div>\n    </div>\n    <div class=\"grid grid-cols-4 gap-x-5 gap-y-7\" data-kid=\"1-4\">\n        <article class=\"min-w-0 rounded-[22px] border border-[#DCE5F0] bg-white p-3 shadow-[0_10px_28px_-20px_rgba(10,32,71,0.22)]\" data-kid=\"1-4-1\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-4-1-1\">\n                <h3 class=\"text-[12px] font-bold text-[#0A2047]\" data-kid=\"1-4-1-1-1\">\n                    01 · Sign In\n                </h3>\n                <span class=\"rounded-full bg-[#EAF1FA] px-2 py-1 text-[9px] font-semibold text-[#2C4E78]\" data-kid=\"1-4-1-1-2\">\n                    Student / teacher\n                </span>\n            </div>\n            <div class=\"relative mx-auto h-[628px] max-w-[304px] overflow-hidden rounded-[27px] border-[5px] border-[#14233A] bg-white shadow-inner\" data-kid=\"1-4-1-2\">\n                <div class=\"flex h-7 items-center justify-between px-4 text-[9px] font-bold text-[#14233A]\" data-kid=\"1-4-1-2-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-4-1-2-1-1\" data-name=\"phone time display\" data-reason=\"time re-initialized by system clock script\">\n                        9:41\n                    </span>\n                    <span data-kid=\"1-4-1-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-[#14233A]\" data-kid=\"1-4-1-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-4 text-[14px] text-[#14233A]\" data-kid=\"1-4-1-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"px-5 pt-2\" data-kid=\"1-4-1-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2-2-1\">\n                        <img alt=\"QR-ATT app icon\" class=\"h-12 w-12 rounded-[14px] border border-[#DCE5F0] object-cover\" data-kid=\"1-4-1-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                        <div data-kid=\"1-4-1-2-2-1-2\">\n                            <div class=\"text-[17px] font-extrabold text-[#0A2047]\" data-kid=\"1-4-1-2-2-1-2-1\" style=\"font-family:'Manrope',sans-serif\">\n                                QR-ATT\n                            </div>\n                            <div class=\"text-[10px] text-[#60718A]\" data-kid=\"1-4-1-2-2-1-2-2\">\n                                QR Attendance System\n                            </div>\n                        </div>\n                    </div>\n                    <h4 class=\"mt-7 text-[21px] font-extrabold tracking-[-0.04em] text-[#0A2047]\" data-kid=\"1-4-1-2-2-2\" style=\"font-family:'Manrope',sans-serif\">\n                        Welcome back\n                    </h4>\n                    <p class=\"mt-1 text-[11px] text-[#60718A]\" data-kid=\"1-4-1-2-2-3\">\n                        Sign in to record your attendance.\n                    </p>\n                    <label class=\"mt-5 block text-[10px] font-bold text-[#223550]\" data-kid=\"1-4-1-2-2-4\">\n                        Email\n                    </label>\n                    <div class=\"mt-1 flex h-11 items-center gap-2 rounded-xl border border-[#D8E2EE] bg-[#FBFCFE] px-3\" data-kid=\"1-4-1-2-2-5\">\n                        <i class=\"ti ti-mail text-[15px] text-[#45668F]\" data-kid=\"1-4-1-2-2-5-1\">\n                        </i>\n                        <span class=\"text-[11px] text-[#8390A1]\" data-kid=\"1-4-1-2-2-5-2\">\n                            you@school.edu\n                        </span>\n                    </div>\n                    <label class=\"mt-3 block text-[10px] font-bold text-[#223550]\" data-kid=\"1-4-1-2-2-6\">\n                        Password\n                    </label>\n                    <div class=\"mt-1 flex h-11 items-center gap-2 rounded-xl border border-[#D8E2EE] bg-[#FBFCFE] px-3\" data-kid=\"1-4-1-2-2-7\">\n                        <i class=\"ti ti-lock text-[15px] text-[#45668F]\" data-kid=\"1-4-1-2-2-7-1\">\n                        </i>\n                        <span class=\"flex-1 text-[12px] tracking-[0.2em] text-[#6A7788]\" data-kid=\"1-4-1-2-2-7-2\">\n                            ••••••••\n                        </span>\n                        <i class=\"ti ti-eye text-[15px] text-[#566B85]\" data-kid=\"1-4-1-2-2-7-3\">\n                        </i>\n                    </div>\n                    <div class=\"mt-3 flex items-start gap-2 rounded-xl border border-[#F2D6D2] bg-[#FFF7F6] px-3 py-2\" data-kid=\"1-4-1-2-2-8\">\n                        <i class=\"ti ti-alert-circle mt-0.5 text-[13px] text-[#B3261E]\" data-kid=\"1-4-1-2-2-8-1\">\n                        </i>\n                        <div class=\"text-[10px] leading-[15px] text-[#8C3530]\" data-kid=\"1-4-1-2-2-8-2\">\n                            We couldn’t sign you in. Check your email and password.\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex h-11 items-center justify-center gap-2 rounded-xl bg-[#153E78] text-[12px] font-bold text-white\" data-kid=\"1-4-1-2-2-9\">\n                        <i class=\"ti ti-arrow-right text-[15px] text-white\" data-kid=\"1-4-1-2-2-9-1\">\n                        </i>\n                        Sign In\n                    </div>\n                    <div class=\"mt-4 text-center text-[10px] text-[#5F6F85]\" data-kid=\"1-4-1-2-2-10\">\n                        New to QR-ATT?\n                        <b class=\"text-[#153E78]\" data-kid=\"1-4-1-2-2-10-1\">\n                            Create account\n                        </b>\n                    </div>\n                    <div class=\"mt-5 border-t border-[#E5EBF3] pt-3 text-center text-[9px] text-[#78869A]\" data-kid=\"1-4-1-2-2-11\">\n                        Error appears inline; fields remain available to correct.\n                    </div>\n                </div>\n            </div>\n        </article>\n        <article class=\"min-w-0 rounded-[22px] border border-[#DCE5F0] bg-white p-3 shadow-[0_10px_28px_-20px_rgba(10,32,71,0.22)]\" data-kid=\"1-4-2\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-4-2-1\">\n                <h3 class=\"text-[12px] font-bold text-[#0A2047]\" data-kid=\"1-4-2-1-1\">\n                    02 · Register\n                </h3>\n                <span class=\"rounded-full bg-[#EAF1FA] px-2 py-1 text-[9px] font-semibold text-[#2C4E78]\" data-kid=\"1-4-2-1-2\">\n                    Role explained\n                </span>\n            </div>\n            <div class=\"relative mx-auto h-[628px] max-w-[304px] overflow-hidden rounded-[27px] border-[5px] border-[#14233A] bg-white shadow-inner\" data-kid=\"1-4-2-2\">\n                <div class=\"flex h-7 items-center justify-between px-4 text-[9px] font-bold text-[#14233A]\" data-kid=\"1-4-2-2-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-4-2-2-1-1\" data-name=\"phone time display\" data-reason=\"time re-initialized by system clock script\">\n                        9:41\n                    </span>\n                    <span data-kid=\"1-4-2-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-[#14233A]\" data-kid=\"1-4-2-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-4 text-[14px] text-[#14233A]\" data-kid=\"1-4-2-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"px-5 pt-2\" data-kid=\"1-4-2-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-2-2-2-1\">\n                        <img alt=\"QR-ATT app icon\" class=\"h-11 w-11 rounded-[13px] border border-[#DCE5F0] object-cover\" data-kid=\"1-4-2-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                        <div data-kid=\"1-4-2-2-2-1-2\">\n                            <div class=\"text-[16px] font-extrabold text-[#0A2047]\" data-kid=\"1-4-2-2-2-1-2-1\" style=\"font-family:'Manrope',sans-serif\">\n                                QR-ATT\n                            </div>\n                            <div class=\"text-[9px] text-[#60718A]\" data-kid=\"1-4-2-2-2-1-2-2\">\n                                QR Attendance System\n                            </div>\n                        </div>\n                    </div>\n                    <h4 class=\"mt-4 text-[19px] font-extrabold tracking-[-0.04em] text-[#0A2047]\" data-kid=\"1-4-2-2-2-2\" style=\"font-family:'Manrope',sans-serif\">\n                        Create your account\n                    </h4>\n                    <p class=\"mt-0.5 text-[10px] text-[#60718A]\" data-kid=\"1-4-2-2-2-3\">\n                        Choose how you’ll use QR-ATT.\n                    </p>\n                    <label class=\"mt-3 block text-[9px] font-bold text-[#223550]\" data-kid=\"1-4-2-2-2-4\">\n                        Full name\n                    </label>\n                    <div class=\"mt-1 flex h-9 items-center rounded-lg border border-[#D8E2EE] bg-[#FBFCFE] px-3 text-[10px] text-[#8491A1]\" data-kid=\"1-4-2-2-2-5\">\n                        Your name\n                    </div>\n                    <label class=\"mt-2 block text-[9px] font-bold text-[#223550]\" data-kid=\"1-4-2-2-2-6\">\n                        I am a...\n                    </label>\n                    <div class=\"mt-1 grid grid-cols-2 gap-2\" data-kid=\"1-4-2-2-2-7\">\n                        <div class=\"rounded-xl border border-[#153E78] bg-[#EAF1FA] p-2\" data-kid=\"1-4-2-2-2-7-1\">\n                            <div class=\"flex items-center gap-1.5 text-[10px] font-bold text-[#0A2047]\" data-kid=\"1-4-2-2-2-7-1-1\">\n                                <i class=\"ti ti-circle-dot text-[13px] text-[#153E78]\" data-kid=\"1-4-2-2-2-7-1-1-1\">\n    