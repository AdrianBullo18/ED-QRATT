                   </div>\n                            <div class=\"mt-4 border-t border-[#E5EBF3] pt-3\" data-kid=\"1-5-3-2-2-4-2-5\">\n                                <div class=\"text-[9px] font-bold uppercase tracking-[0.08em] text-[#71819A]\" data-kid=\"1-5-3-2-2-4-2-5-1\">\n                                    Account\n                                </div>\n                                <div class=\"mt-1 flex items-center justify-between text-[10px] text-[#61728A]\" data-kid=\"1-5-3-2-2-4-2-5-2\">\n                                    <span data-kid=\"1-5-3-2-2-4-2-5-2-1\">\n                                        QR-ATT attendance account\n                                    </span>\n                                    <i class=\"ti ti-chevron-right text-[13px] text-[#8491A1]\" data-kid=\"1-5-3-2-2-4-2-5-2-2\">\n                                    </i>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-2 rounded-xl border border-[#DCE5F0] bg-white px-3 py-3\" data-kid=\"1-5-3-2-2-5\">\n                        <i class=\"ti ti-info-circle mt-0.5 text-[14px] text-[#567397]\" data-kid=\"1-5-3-2-2-5-1\">\n                        </i>\n                        <div class=\"text-[9px] leading-[14px] text-[#61728A]\" data-kid=\"1-5-3-2-2-5-2\">\n                            Your role controls which event tools are available.\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex h-10 items-center justify-center gap-2 rounded-xl border border-[#D8E2EE] bg-white text-[10px] font-bold text-[#27415F]\" data-kid=\"1-5-3-2-2-6\">\n                        <i class=\"ti ti-logout text-[14px] text-[#27415F]\" data-kid=\"1-5-3-2-2-6-1\">\n                        </i>\n                        Sign out\n                    </div>\n                </div>\n                <div class=\"absolute bottom-0 left-0 right-0 flex h-[54px] items-center justify-around border-t border-[#DCE5F0] bg-white\" data-kid=\"1-5-3-2-3\">\n                    <div class=\"flex flex-col items-center gap-0.5 text-[#77869A]\" data-kid=\"1-5-3-2-3-1\">\n                        <i class=\"ti ti-home text-[16px] text-[#77869A]\" data-kid=\"1-5-3-2-3-1-1\">\n                        </i>\n                        <span class=\"text-[8px]\" data-kid=\"1-5-3-2-3-1-2\">\n                            Home\n                        </span>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-0.5 text-[#77869A]\" data-kid=\"1-5-3-2-3-2\">\n                        <i class=\"ti ti-scan text-[16px] text-[#77869A]\" data-kid=\"1-5-3-2-3-2-1\">\n                        </i>\n                        <span class=\"text-[8px]\" data-kid=\"1-5-3-2-3-2-2\">\n                            Scan\n                        </span>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-0.5 text-[#77869A]\" data-kid=\"1-5-3-2-3-3\">\n                        <i class=\"ti ti-history text-[16px] text-[#77869A]\" data-kid=\"1-5-3-2-3-3-1\">\n                        </i>\n                        <span class=\"text-[8px]\" data-kid=\"1-5-3-2-3-3-2\">\n                            History\n                        </span>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-0.5 text-[#153E78]\" data-kid=\"1-5-3-2-3-4\" data-name=\"profile navigation tab\">\n                        <i class=\"ti ti-user text-[16px] text-[#153E78]\" data-kid=\"1-5-3-2-3-4-1\">\n                        </i>\n                        <span class=\"text-[8px] font-bold\" data-kid=\"1-5-3-2-3-4-2\" data-name=\"profile navigation tab label\">\n                            Profile\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </article>\n    </div>\n    <footer class=\"mt-6 flex items-center justify-between rounded-2xl border border-[#DCE5F0] bg-white px-5 py-3 text-[10px] text-[#687991]\" data-kid=\"1-6\">\n        <span data-kid=\"1-6-1\">\n            <b class=\"text-[#0A2047]\" data-kid=\"1-6-1-1\">\n                Design intent:\n            </b>\n            consistent route labels, larger task data, deliberate role differences, and clear recovery cues—without changing attendance rules.\n        </span>\n        <span class=\"font-semibold text-[#60718A]\" data-kid=\"1-6-2\">\n            QR-ATT · Navy & White · White-First\n        </span>\n    </footer>\n</div>\n",
