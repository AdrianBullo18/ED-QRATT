      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .board{--navy:#081b39;--navy2:#0e2c57;--navy3:#153d72;--blue:#1d579e;--ink:#12243c;--muted:#65758b;--paper:#f3f7fc;--line:#d8e2ef;--tint:#eaf2fb;--white:#fff;--green:#1f805b;--greenbg:#e7f5ee;--red:#b3261e;--redbg:#fff0ee;color:var(--ink);font-family:'DM Sans',Arial,sans-serif}\n  .phone{height:620px;background:var(--navy);border-radius:26px;overflow:hidden;position:relative;box-shadow:0 12px 28px rgba(8,27,57,.16);border:1px solid #193b67}\n  .screen-scroll{height:calc(100% - 64px);overflow:hidden}\n  .field{height:38px;border:1px solid var(--line);border-radius:9px;background:var(--white);display:flex;align-items:center;padding:0 10px;color:var(--muted);font-size:11px;gap:7px}\n  .field-label{font-size:9px;font-weight:700;letter-spacing:.06em;color:#31445d;margin:0 0 4px}\n  .mini-btn{min-height:37px;border-radius:9px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:11px;font-weight:700;padding:0 11px}\n  .nav-item{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:8px;font-weight:600;color:#7890ac}\n  .nav-item.active{color:var(--blue)}\n  .icon{display:inline-flex;align-items:center;justify-content:center;flex:none}\n  @media(max-width:800px){.screens{grid-template-columns:repeat(2,minmax(0,1fr))!important}.board{padding-left:18px!important;padding-right:18px!important}.phone{height:640px}}\n</style>\n<div class=\"board min-h-[1000px] w-full bg-[#eaf0f7] px-8 py-8\" data-kid=\"1\" style=\"font-family:'DM Sans',Arial,sans-serif;\">\n    <header class=\"mx-auto mb-5 flex max-w-[1360px] items-end justify-between gap-6 rounded-[20px] bg-[var(--navy)] px-7 py-5 text-[var(--white)] shadow-[0_12px_28px_rgba(8,27,57,0.16)]\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-4\" data-kid=\"1-1-1\">\n            <img alt=\"QR-ATT app icon\" class=\"h-12 w-12 rounded-[13px] border border-white/20 object-cover\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n            <div data-kid=\"1-1-1-2\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.24em] text-[#a9c7e9]\" data-kid=\"1-1-1-2-1\">\n                    QR-ATT · Product UI direction\n                </p>\n                <h1 class=\"mt-1 text-[25px] font-extrabold tracking-[-0.04em]\" data-kid=\"1-1-1-2-2\">\n                    Navy & White\n                </h1>\n            </div>\n        </div>\n        <p class=\"max-w-[460px] text-right text-[12px] leading-5 text-[#dce8f7]\" data-kid=\"1-1-2\">\n            A navy-forward system for student check-in and teacher event tools. White work surfaces, precise blue accents, semantic feedback.\n        </p>\n    </header>\n    <section class=\"mx-auto mb-7 grid max-w-[1360px] grid-cols-[1.1fr_1fr] gap-4\" data-kid=\"1-2\">\n        <div class=\"rounded-[16px] border border-[var(--line)] bg-white px-5 py-4\" data-kid=\"1-2-1\">\n            <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-1-1\">\n                <h2 class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--navy)]\" data-kid=\"1-2-1-1-1\">\n                    Palette\n                </h2>\n                <span class=\"text-[9px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-1-1-2\">\n                    Blue & white first · meaning colors only for feedback\n                </span>\n            </div>\n            <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-1-2\">\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--navy)]\" data-kid=\"1-2-1-2-1-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-1-2\">\n                        Navy shell\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-2\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--navy2)]\" data-kid=\"1-2-1-2-2-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-2-2\">\n                        Header blue\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-3\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--blue)]\" data-kid=\"1-2-1-2-3-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-3-2\">\n                        Action blue\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-4\">\n                    <span class=\"h-6 w-6 rounded-md border border-[var(--line)] bg-white\" data-kid=\"1-2-1-2-4-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-4-2\">\n                        White surface\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-5\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--tint)]\" data-kid=\"1-2-1-2-5-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-5-2\">\n                        Selected / focus\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-6\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--greenbg)]\" data-kid=\"1-2-1-2-6-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-6-2\">\n                        Success only\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-lg border border-[var(--line)] px-2 py-1.5\" data-kid=\"1-2-1-2-7\">\n                    <span class=\"h-6 w-6 rounded-md bg-[var(--redbg)]\" data-kid=\"1-2-1-2-7-1\">\n                    </span>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-2-1-2-7-2\">\n                        Error only\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"rounded-[16px] border border-[var(--line)] bg-white px-5 py-4\" data-kid=\"1-2-2\">\n            <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-2-1\">\n                <h2 class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--navy)]\" data-kid=\"1-2-2-1-1\">\n                    Control states\n                </h2>\n                <span class=\"text-[9px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-2-1-2\">\n                    Consistent touch size & feedback\n                </span>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-2\">\n                <button class=\"mini-btn bg-[var(--blue)] text-white\" data-kid=\"1-2-2-2-1\">\n                    Primary action\n                </button>\n                <button class=\"mini-btn border border-[var(--line)] bg-white text-[var(--navy)]\" data-kid=\"1-2-2-2-2\">\n                    Secondary\n                </button>\n                <button class=\"mini-btn bg-[#edf1f6] text-[#6e7e91]\" data-kid=\"1-2-2-2-3\">\n                    Unavailable\n                </button>\n                <span class=\"rounded-lg border border-[#f1c5bf] bg-[var(--redbg)] px-3 py-2 text-[9px] font-semibold text-[var(--red)]\" data-kid=\"1-2-2-2-4\">\n                    Check the highlighted field\n                </span>\n                <span class=\"rounded-lg border border-[#b8e0cc] bg-[var(--greenbg)] px-3 py-2 text-[9px] font-semibold text-[var(--green)]\" data-kid=\"1-2-2-2-5\">\n                    Attendance recorded\n                </span>\n            </div>\n        </div>\n    </section>\n    <main class=\"screens mx-auto grid max-w-[1360px] grid-cols-4 gap-5\" data-kid=\"1-3\">\n        <article class=\"min-w-0\" data-kid=\"1-3-1\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-1-1\">\n                <h2 class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--navy)]\" data-kid=\"1-3-1-1-1\">\n                    01 · Sign In\n                </h2>\n                <span class=\"text-[9px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-1-2\">\n                    Initial form\n                </span>\n            </div>\n            <section class=\"phone\" data-kid=\"1-3-1-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[var(--navy)] px-4 text-[9px] font-bold text-white\" data-kid=\"1-3-1-2-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1\" data-name=\"status bar clock\" data-reason=\"time updated periodically by system script\">\n                        9:41\n                    </span>\n                    <span class=\"tracking-[.14em]\" data-kid=\"1-3-1-2-1-2\">\n                        ●●●  ▰\n                    </span>\n                </div>\n                <div class=\"flex h-[70px] items-center gap-3 border-b border-white/10 bg-[var(--navy)] px-4\" data-kid=\"1-3-1-2-2\">\n                    <img alt=\"QR-ATT\" class=\"h-10 w-10 rounded-[10px] object-cover\" data-kid=\"1-3-1-2-2-1\" decoding=\"as