      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .board { font-family:'DM Sans',sans-serif; }\n  .display { font-family:'Manrope',sans-serif; }\n</style>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js\">\n</script>\n<div class=\"board min-h-[1640px] w-[1440px] bg-[#F3F7FC] px-8 py-8 text-[#17243A]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mb-7 overflow-hidden rounded-[20px] bg-[#081B3A] text-white shadow-[0_12px_26px_rgba(8,27,58,0.12)]\" data-kid=\"1-1\">\n        <div class=\"flex items-center justify-between px-7 py-5\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\">\n                <img alt=\"QR-ATT app icon\" class=\"h-12 w-12 rounded-[12px] object-cover\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"display text-[22px] font-extrabold tracking-[-0.04em]\" data-kid=\"1-1-1-1-2-1\">\n                        QR-ATT\n                    </div>\n                    <div class=\"text-[12px] text-white/75\" data-kid=\"1-1-1-1-2-2\">\n                        QR Attendance System · App-wide UI direction\n                    </div>\n                </div>\n            </div>\n            <div class=\"rounded-full border border-white/25 px-4 py-2 text-[12px] font-semibold tracking-wide text-white/90\" data-kid=\"1-1-1-2\">\n                03 / STREAMLINED SERVICE\n            </div>\n        </div>\n    </header>\n    <div class=\"mb-5 flex items-end justify-between\" data-kid=\"1-2\">\n        <div data-kid=\"1-2-1\">\n            <h1 class=\"display text-[28px] font-bold tracking-[-0.04em] text-[#081B3A]\" data-kid=\"1-2-1-1\">\n                Dark navy, clear white surfaces.\n            </h1>\n            <p class=\"mt-1 text-[14px] text-[#55657A]\" data-kid=\"1-2-1-2\">\n                Seven mobile screens, one calm attendance workflow, clearer actions and real state feedback.\n            </p>\n        </div>\n        <div class=\"rounded-full bg-white px-4 py-2 text-[12px] font-semibold text-[#0F1199] shadow-[0_2px_8px_rgba(8,27,58,0.06)]\" data-kid=\"1-2-2\">\n            Student + Teacher\n        </div>\n    </div>\n    <div class=\"grid grid-cols-4 gap-4\" data-kid=\"1-3\">\n        <!-- 01 SIGN IN -->\n        <article class=\"rounded-[18px] border border-[#DCE5F0] bg-white p-3 shadow-[0_5px_18px_rgba(8,27,58,0.05)]\" data-kid=\"1-3-1\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-1-1\">\n                <span class=\"text-[11px] font-bold uppercase tracking-[0.13em] text-[#0F1199]\" data-kid=\"1-3-1-1-1\">\n                    01 · Sign In\n                </span>\n                <span class=\"text-[11px] font-medium text-[#76859A]\" data-kid=\"1-3-1-1-2\">\n                    Error example\n                </span>\n            </div>\n            <div class=\"relative h-[626px] overflow-hidden rounded-[18px] border border-[#D9E2EE] bg-white\" data-kid=\"1-3-1-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[#081B3A] px-4 text-[11px] font-semibold text-white\" data-kid=\"1-3-1-2-1\">\n                    <span data-kid=\"1-3-1-2-1-1\">\n                        9:41\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-3-1-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-white\" data-kid=\"1-3-1-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-3 text-[14px] text-white\" data-kid=\"1-3-1-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"h-[88px] bg-[#081B3A] px-5 pt-2\" data-kid=\"1-3-1-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-2-2-1\">\n                        <img alt=\"QR-ATT icon\" class=\"h-11 w-11 rounded-[10px] object-cover\" data-kid=\"1-3-1-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                        <div data-kid=\"1-3-1-2-2-1-2\">\n                            <div class=\"display text-[18px] font-extrabold text-white\" data-kid=\"1-3-1-2-2-1-2-1\">\n                                QR-ATT\n                            </div>\n                            <div class=\"text-[11px] text-white/75\" data-kid=\"1-3-1-2-2-1-2-2\">\n                                QR Attendance System\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"px-4 pt-5\" data-kid=\"1-3-1-2-3\">\n                    <div class=\"display text-[18px] font-bold text-[#081B3A]\" data-kid=\"1-3-1-2-3-1\">\n                        Welcome back\n                    </div>\n                    <div class=\"mt-1 text-[12px] leading-[17px] text-[#596A80]\" data-kid=\"1-3-1-2-3-2\">\n                        Sign in to record your attendance.\n                    </div>\n                    <div class=\"mt-4\" data-kid=\"1-3-1-2-3-3\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-1-2-3-3-1\">\n                            Email\n                        </label>\n                        <div class=\"flex h-11 items-center gap-2.5 rounded-[9px] border border-[#CFD9E6] bg-white px-3\" data-kid=\"1-3-1-2-3-3-2\">\n                            <i class=\"ti ti-mail text-[17px] text-[#0F1199]\" data-kid=\"1-3-1-2-3-3-2-1\">\n                            </i>\n                            <span class=\"text-[13px] text-[#8794A6]\" data-kid=\"1-3-1-2-3-3-2-2\">\n                                you@school.edu\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-3\" data-kid=\"1-3-1-2-3-4\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-1-2-3-4-1\">\n                            Password\n                        </label>\n                        <div class=\"flex h-11 items-center gap-2.5 rounded-[9px] border border-[#CFD9E6] bg-white px-3\" data-kid=\"1-3-1-2-3-4-2\">\n                            <i class=\"ti ti-lock text-[17px] text-[#0F1199]\" data-kid=\"1-3-1-2-3-4-2-1\">\n                            </i>\n                            <span class=\"flex-1 text-[15px] tracking-[0.14em] text-[#64758C]\" data-kid=\"1-3-1-2-3-4-2-2\">\n                                ••••••••\n                            </span>\n                            <i class=\"ti ti-eye text-[17px] text-[#64758C]\" data-kid=\"1-3-1-2-3-4-2-3\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-start gap-2 rounded-[9px] border border-[#EBC9C8] bg-[#FFF7F6] px-3 py-2.5 text-[12px] leading-[17px] text-[#8F302B]\" data-kid=\"1-3-1-2-3-5\">\n                        <i class=\"ti ti-alert-circle mt-0.5 text-[15px]\" data-kid=\"1-3-1-2-3-5-1\">\n                        </i>\n                        <span data-kid=\"1-3-1-2-3-5-2\">\n                            Sign-in wasn’t successful. Check your email and password, then try again.\n                        </span>\n                    </div>\n                    <button class=\"mt-3 flex h-11 w-full items-center justify-center gap-2 rounded-[9px] bg-[#0F1199] text-[14px] font-bold text-white\" data-kid=\"1-3-1-2-3-6\">\n                        <i class=\"ti ti-login-2 text-[16px]\" data-kid=\"1-3-1-2-3-6-1\">\n                        </i>\n                        Sign In\n                    </button>\n                    <div class=\"mt-3 text-center text-[12px] text-[#5C6C82]\" data-kid=\"1-3-1-2-3-7\">\n                        New to QR-ATT?\n                        <span class=\"font-bold text-[#0F1199]\" data-kid=\"1-3-1-2-3-7-1\">\n                            Create account\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </article>\n        <!-- 02 REGISTER -->\n        <article class=\"rounded-[18px] border border-[#DCE5F0] bg-white p-3 shadow-[0_5px_18px_rgba(8,27,58,0.05)]\" data-kid=\"1-3-2\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-2-1\">\n                <span class=\"text-[11px] font-bold uppercase tracking-[0.13em] text-[#0F1199]\" data-kid=\"1-3-2-1-1\">\n                    02 · Register\n                </span>\n                <span class=\"text-[11px] font-medium text-[#76859A]\" data-kid=\"1-3-2-1-2\">\n                    Field guidance\n                </span>\n            </div>\n            <div class=\"relative h-[626px] overflow-hidden rounded-[18px] border border-[#D9E2EE] bg-white\" data-kid=\"1-3-2-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[#081B3A] px-4 text-[11px] font-semibold text-white\" data-kid=\"1-3-2-2-1\">\n                    <span data-kid=\"1-3-2-2-1-1\">\n                        9:41\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-3-2-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-white\" data-kid=\"1-3-2-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-3 text-[14px] text-white\" data-kid=\"1-3-2-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"flex h-[58px] items-center gap-2.5 border-b border-[#E7EDF4] px-4\" data-kid=\"1-3-2-2-2\">\n                    <img alt=\"QR-ATT icon\" class=\"h-9 w-9 rounded-[8px] object-cover\" data-kid=\"1-3-2-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                    <span class=\"display text-[15px] font-bold text-[#081B3A]\" data-kid=\"1-3-2-2-2-2\">\n                        Create account\n                    </span>\n                    <span class=\"ml-auto text-[12px] font-semibold text-[#0F1199]\" data-kid=\"1-3-2-2-2-3\">\n                        1 of 1\n                    </span>\n                </div>\n                <div class=\"px-4 pt-3\" data-kid=\"1-3-2-2-3\">\n                    <p class=\"text-[12px] leading-[17px] text-[#5C6C82]\" data-kid=\"1-3-2-2-3-1\">\n                        Choose your role to see the right attendance tools.\n                    </p>\n                    <div class=\"mt-2 grid grid-cols-2 gap-2\" data-kid=\"1-3-2-2-3-2\">\n                        <div class=\"rounded-[9px] border border-[#0F1199] bg-[#F2F6FF] px-2.5 py-2\" data-kid=\"1-3-2-2-3-2-1\">\n                            <div class=\"flex items-center gap-1.5 text-[12px] font-bold text-[#081B3A]\" data-kid=\"1-3-2-2-3-2-1-1\">\n                                <i class=\"ti ti-circle-check-filled text-[14px] text-[#0F1199]\" data-kid=\"1-3-2-2-3-2-1-1-1\">\n                                </i>\n                                Student\n                            </div>\n                            <div class=\"mt-1 text-[11px] leading-[15px] text-[#5C6C82]\" data-kid=\"1-3-2-2-3-2-1-2\">\n                                Scan and review attendance.\n                            </div>\n                        </div>\n                        <div class=\"rounded-[9px] border border-[#D5DFEB] bg-white px-2.5 py-2\" data-kid=\"1-3-2-2-3-2-2\">\n                            <div class=\"flex items-center gap-1.5 text-[12px] font-bold text-[#26364E]\" data-kid=\"1-3-2-2-3-2-2-1\">\n                                <i class=\"ti ti-circle text-[14px] text-[#8695A8]\" data-kid=\"1-3-2-2-3-2-2-1-1\">\n                                </i>\n                                Teacher\n                            </div>\n                            <div class=\"mt-1 text-[11px] leading-[15px] text-[#5C6C82]\" data-kid=\"1-3-2-2-3-2-2-2\">\n                                Create events and view check-ins.\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-2 space-y-2.5\" data-kid=\"1-3-2-2-3-3\">\n                        <div data-kid=\"1-3-2-2-3-3-1\">\n                            <div class=\"mb-1 text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-2-2-3-3-1-1\">\n                                Full name\n                            </div>\n                            <div class=\"flex h-9 items-center rounded-[8px] border border-[#CFD9E6] px-3 text-[12px] text-[#8896A8]\" data-kid=\"1-3-2-2-3-3-1-2\">\n                                Your name\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-3-2\">\n                            <div class=\"mb-1 text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-2-2-3-3-2-1\">\n                                School email\n                            </div>\n                            <div class=\"flex h-9 items-center rounded-[8px] border border-[#CFD9E6] px-3 text-[12px] text-[#8896A8]\" data-kid=\"1-3-2-2-3-3-2-2\">\n                                you@school.edu\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-3-3\">\n                            <div class=\"mb-1 flex justify-between text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-2-2-3-3-3-1\">\n                                <span data-kid=\"1-3-2-2-3-3-3-1-1\">\n                                    Password\n                                </span>\n                                <span class=\"font-normal text-[#74849A]\" data-kid=\"1-3-2-2-3-3-3-1-2\">\n                                    At least 6 characters\n                                </span>\n                            </div>\n                            <div class=\"flex h-9 items-center rounded-[8px] border border-[#CFD9E6] px-3 text-[13px] tracking-[0.14em] text-[#64758C]\" data-kid=\"1-3-2-2-3-3-3-2\">\n                                ••••••••\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-3-4\">\n                            <div class=\"mb-1 text-[12px] font-semibold text-[#26364E]\" data-kid=\"1-3-2-2-3-3-4-1\">\n                                Confirm password\n                            </div>\n                            <div class=\"flex h-9 items-center rounded-[8px] border border-[#B54A43] bg-[#FFF9F8] px-3 text-[12px] text-[#78879A]\" data-kid=\"1-3-2-2-3-3-4-2\">\n                                ••••••••\n                            </div>\n                            <div class=\"mt-1 flex items-center gap-1 text-[11px] text-[#A33C36]\" data-kid=\"1-3-2-2-3-3-4-3\">\n                                <i class=\"ti ti-alert-circle text-[13px]\" data-kid=\"1-3-2-2-3-3-4-3-1\">\n                                </i>\n                                Passwords don’t match.\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"mt-3 flex h-10 w-full items-center justify-center gap-2 rounded-[8px] bg-[#0F1199] text-[13px] font-bold text-white\" data-kid=\"1-3-2-2-3-4\">\n                        <i class=\"ti ti-user-plus text-[15px]\" data-kid=\"1-3-2-2-3-4-1\">\n                        </i>\n                        Create account\n                    </button>\n                    <p class=\"mt-2 text-center text-[11px] leading-[15px] text-[#68788E]\" data-kid=\"1-3-2-2-3-5\">\n                        If email confirmation is on, check your inbox before signing in.\n                    </p>\n                </div>\n            </div>\n        </article>\n        <!-- 03 STUDENT HOME -->\n        <article class=\"rounded-[18px] border border-[#DCE5F0] bg-white p-3 shadow-[0_5px_18px_rgba(8,27,58,0.05)]\" data-kid=\"1-3-3\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-3-1\">\n                <span class=\"text-[11px] font-bold uppercase tracking-[0.13em] text-[#0F1199]\" data-kid=\"1-3-3-1-1\">\n                    03 · Student Home\n                </span>\n                <span class=\"text-[11px] font-medium text-[#76859A]\" data-kid=\"1-3-3-1-2\">\n                    Scan first\n                </span>\n            </div>\n            <div class=\"relative h-[626px] overflow-hidden rounded-[18px] border border-[#D9E2EE] bg-[#F8FAFD]\" data-kid=\"1-3-3-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[#081B3A] px-4 text-[11px] font-semibold text-white\" data-kid=\"1-3-3-2-1\">\n                    <span data-kid=\"1-3-3-2-1-1\">\n                        9:41\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-3-3-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-white\" data-kid=\"1-3-3-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-3 text-[14px] text-white\" data-kid=\"1-3-3-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"bg-[#081B3A] px-4 pb-4 pt-3 text-white\" data-kid=\"1-3-3-2-2\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-3-3-2-2-1\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-2-2-1-1\">\n                            <img alt=\"QR-ATT icon\" class=\"h-9 w-9 rounded-[8px] object-cover\" data-kid=\"1-3-3-2-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                            <div data-kid=\"1-3-3-2-2-1-1-2\">\n                                <div class=\"display text-[15px] font-bold\" data-kid=\"1-3-3-2-2-1-1-2-1\">\n                                    QR-ATT\n                                </div>\n                                <div class=\"text-[11px] text-white/70\" data-kid=\"1-3-3-2-2-1-1-2-2\">\n                                    Student dashboard\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"flex h-9 w-9 items-center justify-center rounded-[8px] border border-white/20 bg-white/10\" data-kid=\"1-3-3-2-2-1-2\">\n                            <i class=\"ti ti-logout text-[17px] text-white\" data-kid=\"1-3-3-2-2-1-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 text-[12px] font-semibold text-[#DCE8FA]\" data-kid=\"1-3-3-2-2-2\">\n                        Welcome back\n                    </div>\n                    <div class=\"display mt-0.5 text-[20px] font-bold\" data-kid=\"1-3-3-2-2-3\">\n                        Your attendance\n                    </div>\n                </div>\n                <div class=\"px-4 pb-3 pt-3\" data-kid=\"1-3-3-2-3\">\n                    <div class=\"rounded-[13px] border border-[#D8E2EE] bg-white p-3.5\" data-kid=\"1-3-3-2-3-1\">\n                        <div class=\"text-[12px] font-semibold text-[#6B7C92]\" data-kid=\"1-3-3-2-3-1-1\">\n                            NEXT STEP\n                        </div>\n                        <div class=\"display mt-1 text-[16px] font-bold leading-[21px] text-[#081B3A]\" data-kid=\"1-3-3-2-3-1-2\">\n                            Record attendance\n                        </div>\n                        <p class=\"mt-1 text-[12px] leading-[17px] text-[#5C6C82]\" data-kid=\"1-3-3-2-3-1-3\">\n                            Scan your event QR code when you arrive.\n                        </p>\n                        <button class=\"mt-3 flex h-11 w-full items-center justify-center gap-2 rounded-[9px] bg-[#0F1199] text-[14px] font-bold text-white\" data-kid=\"1-3-3-2-3-1-4\">\n                            <i class=\"ti ti-scan text-[17px]\" data-kid=\"1-3-3-2-3-1-4-1\">\n                            </i>\n                            Scan QR Code\n                        </button>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-between border-b border-[#E0E7EF] py-3\" data-kid=\"1-3-3-2-3-2\">\n                        <div data-kid=\"1-3-3-2-3-2-1\">\n                            <div class=\"text-[13px] font-bold text-[#15243B]\" data-kid=\"1-3-3-2-3-2-1-1\">\n                                Attendance History\n                            </div>\n                            <div class=\"mt-0.5 text-[11px] text-[#6B7C92]\" data-kid=\"1-3-3-2-3-2-1-2\">\n                                Review your recent check-ins\n                            </div>\n                        </div>\n                        <i class=\"ti ti-chevron-right text-[17px] text-[#0F1199]\" data-kid=\"1-3-3-2-3-2-2\">\n                        </i>\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between border-b border-[#E0E7EF] py-3\" data-kid=\"1-3-3-2-3-3\">\n                        <div data-kid=\"1-3-3-2-3-3-1\">\n                            <div class=\"text-[13px] font-bold text-[#15243B]\" data-kid=\"1-3-3-2-3-3-1-1\">\n                                Profile\n                            </div>\n                            <div class=\"mt-0.5 text-[11px] text-[#6B7C92]\" data-kid=\"1-3-3-2-3-3-1-2\">\n                                Your account details\n                            </div>\n                        </div>\n                        <i cla