v class=\"field-label\" data-kid=\"1-3-6-2-3-1-3-1\">\n                                Starts\n                            </div>\n                            <div class=\"field !h-[31px] text-[9px] text-[var(--ink)]\" data-kid=\"1-3-6-2-3-1-3-2\">\n                                Oct 01, 2026 · 8:30 AM\n                                <i class=\"ti ti-calendar ml-auto\" data-kid=\"1-3-6-2-3-1-3-2-1\" style=\"font-size:12px;color:var(--blue);width:12px;height:12px\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-6-2-3-1-4\">\n                            <div class=\"field-label\" data-kid=\"1-3-6-2-3-1-4-1\">\n                                Ends\n                            </div>\n                            <div class=\"field !h-[31px] text-[9px] text-[var(--ink)]\" data-kid=\"1-3-6-2-3-1-4-2\">\n                                Oct 01, 2026 · 9:30 AM\n                                <i class=\"ti ti-calendar ml-auto\" data-kid=\"1-3-6-2-3-1-4-2-1\" style=\"font-size:12px;color:var(--blue);width:12px;height:12px\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-6-2-3-1-5\">\n                            <div class=\"field-label\" data-kid=\"1-3-6-2-3-1-5-1\">\n                                Quick end time\n                            </div>\n                            <div class=\"flex gap-1.5\" data-kid=\"1-3-6-2-3-1-5-2\">\n                                <span class=\"rounded-md border border-[var(--line)] bg-white px-2 py-1 text-[8px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-6-2-3-1-5-2-1\">\n                                    +30 min\n                                </span>\n                                <span class=\"rounded-md border border-[var(--blue)] bg-[var(--tint)] px-2 py-1 text-[8px] font-extrabold text-[var(--blue)]\" data-kid=\"1-3-6-2-3-1-5-2-2\">\n                                    +1 hour ✓\n                                </span>\n                                <span class=\"rounded-md border border-[var(--line)] bg-white px-2 py-1 text-[8px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-6-2-3-1-5-2-3\">\n                                    +2 hours\n                                </span>\n                            </div>\n                        </div>\n                        <button class=\"flex h-8 w-full items-center justify-center gap-1.5 rounded-lg bg-[var(--blue)] text-[9px] font-extrabold text-white\" data-kid=\"1-3-6-2-3-1-6\">\n                            <i class=\"ti ti-device-floppy\" data-kid=\"1-3-6-2-3-1-6-1\" style=\"font-size:13px;color:white;width:13px;height:13px\">\n                            </i>\n                            Create event\n                        </button>\n                    </div>\n                    <div class=\"mt-2.5 rounded-[11px] border border-[var(--line)] bg-white p-2.5\" data-kid=\"1-3-6-2-3-2\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-6-2-3-2-1\">\n                            <div data-kid=\"1-3-6-2-3-2-1-1\">\n                                <p class=\"text-[9px] font-extrabold text-[var(--navy)]\" data-kid=\"1-3-6-2-3-2-1-1-1\">\n                                    QR ready to display\n                                </p>\n                                <p class=\"mt-0.5 text-[7px] text-[var(--muted)]\" data-kid=\"1-3-6-2-3-2-1-1-2\">\n                                    Students scan this code at the event\n                                </p>\n                            </div>\n                            <span class=\"rounded-full bg-[var(--greenbg)] px-2 py-1 text-[7px] font-bold text-[var(--green)]\" data-kid=\"1-3-6-2-3-2-1-2\">\n                                Event saved\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-3\" data-kid=\"1-3-6-2-3-2-2\">\n                            <div class=\"flex h-[82px] w-[82px] items-center justify-center border border-[var(--line)] bg-white p-1\" data-kid=\"1-3-6-2-3-2-2-1\">\n                                <svg aria-label=\"Sample event QR code\" class=\"h-full w-full\" data-kid=\"1-3-6-2-3-2-2-1-1\" viewbox=\"0 0 21 21\">\n                                    <rect fill=\"white\" height=\"21\" width=\"21\">\n                                    </rect>\n                                    <path d=\"M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2zM8 0h2v2H8zM10 2h2v2h-2zM8 4h2v3H8zM11 5h2v2h-2zM7 8h2v2H7zM10 8h1v2h-1zM13 8h2v2h-2zM16 8h2v1h-2zM19 8h2v2h-2zM8 11h2v2H8zM11 11h2v1h-2zM14 11h1v3h-1zM17 11h2v2h-2zM8 14h2v2H8zM11 14h2v2h-2zM14 15h2v2h-2zM17 15h1v2h-1zM19 14h2v2h-2zM8 18h2v3H8zM11 18h3v1h-3zM15 18h2v3h-2zM18 19h3v2h-3z\" fill=\"#081b39\">\n                                    </path>\n                                </svg>\n                            </div>\n                            <p class=\"flex-1 text-[8px] leading-4 text-[var(--muted)]\" data-kid=\"1-3-6-2-3-2-2-2\">\n                                Display this QR on the event screen or print it at the entrance. The event code stays readable below if needed.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"absolute bottom-0 left-0 right-0 flex h-[48px] items-center justify-around border-t border-[var(--line)] bg-white\" data-kid=\"1-3-6-2-4\">\n                    <div class=\"nav-item\" data-kid=\"1-3-6-2-4-1\">\n                        <i class=\"ti ti-home-2\" data-kid=\"1-3-6-2-4-1-1\" style=\"font-size:16px;color:var(--muted);width:16px;height:16px\">\n                        </i>\n                        Home\n                    </div>\n                    <div class=\"nav-item\" data-kid=\"1-3-6-2-4-2\">\n                        <i class=\"ti ti-qrcode\" data-kid=\"1-3-6-2-4-2-1\" style=\"font-size:16px;color:var(--muted);width:16px;height:16px\">\n                        </i>\n                        Scan\n                    </div>\n                    <div class=\"nav-item\" data-kid=\"1-3-6-2-4-3\">\n                        <i class=\"ti ti-clock\" data-kid=\"1-3-6-2-4-3-1\" style=\"font-size:16px;color:var(--muted);width:16px;height:16px\">\n                        </i>\n                        History\n                    </div>\n                    <div class=\"nav-item active\" data-kid=\"1-3-6-2-4-4\">\n                        <i class=\"ti ti-calendar-event\" data-kid=\"1-3-6-2-4-4-1\" style=\"font-size:16px;color:var(--blue);width:16px;height:16px\">\n                        </i>\n                        Events\n                    </div>\n                </div>\n            </section>\n        </article>\n        <article class=\"min-w-0\" data-kid=\"1-3-7\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-7-1\">\n                <h2 class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--navy)]\" data-kid=\"1-3-7-1-1\">\n                    07 · Profile\n                </h2>\n                <span class=\"text-[9px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-7-1-2\">\n                    Account essentials\n                </span>\n            </div>\n            <section class=\"phone\" data-kid=\"1-3-7-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[var(--navy)] px-4 text-[9px] font-bold text-white\" data-kid=\"1-3-7-2-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-3-7-2-1-1\" data-name=\"status bar clock\" data-reason=\"time updated periodically by system script\">\n                        9:41\n                    </span>\n                    <span class=\"tracking-[.14em]\" data-kid=\"1-3-7-2-1-2\">\n                        ●●●  ▰\n                    </span>\n                </div>\n                <div class=\"flex h-[54px] items-center bg-[var(--navy)] px-4\" data-kid=\"1-3-7-2-2\">\n                    <div data-kid=\"1-3-7-2-2-1\">\n                        <p class=\"text-[13px] font-extrabold text-white\" data-kid=\"1-3-7-2-2-1-1\">\n                            Profile\n                        </p>\n                        <p class=\"text-[8px] text-[#b8cde5]\" data-kid=\"1-3-7-2-2-1-2\">\n                            Account details\n                        </p>\n                    </div>\n                </div>\n                <div class=\"screen-scroll bg-[var(--paper)] px-3.5 pb-4 pt-3\" data-kid=\"1-3-7-2-3\">\n                    <div class=\"rounded-[13px] border border-[var(--line)] bg-white p-3.5\" data-kid=\"1-3-7-2-3-1\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-7-2-3-1-1\">\n                            <div class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[var(--tint)]\" data-kid=\"1-3-7-2-3-1-1-1\">\n                                <i class=\"ti ti-user\" data-kid=\"1-3-7-2-3-1-1-1-1\" style=\"font-size:20px;color:var(--blue);width:20px;height:20px\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-3-7-2-3-1-1-2\">\n                                <p class=\"text-[12px] font-extrabold text-[var(--navy)]\" data-kid=\"1-3-7-2-3-1-1-2-1\">\n                                    Student account\n                                </p>\n                                <p class=\"mt-0.5 text-[8px] text-[var(--muted)]\" data-kid=\"1-3-7-2-3-1-1-2-2\">\n                                    student@school.edu\n                                </p>\n                            </div>\n                            <span class=\"ml-auto rounded-full bg-[var(--tint)] px-2 py-1 text-[8px] font-bold text-[var(--blue)]\" data-kid=\"1-3-7