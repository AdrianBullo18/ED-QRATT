        <span data-dynamic=\"true\" data-kid=\"1-5-3-2-1-1\" data-name=\"phone time display\" data-reason=\"time re-initialized by system clock script\">\n                        9:41\n                    </span>\n                    <span data-kid=\"1-5-3-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-[#14233A]\" data-kid=\"1-5-3-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-4 text-[14px] text-[#14233A]\" data-kid=\"1-5-3-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"px-4 pt-5\" data-kid=\"1-5-3-2-2\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#71819A]\" data-kid=\"1-5-3-2-2-1\">\n                        Account\n                    </div>\n                    <h4 class=\"mt-1 text-[21px] font-extrabold tracking-[-0.04em] text-[#0A2047]\" data-kid=\"1-5-3-2-2-2\" style=\"font-family:'Manrope',sans-serif\">\n                        My profile\n                    </h4>\n                    <p class=\"mt-1 text-[10px] text-[#61728A]\" data-kid=\"1-5-3-2-2-3\">\n                        Your details and attendance role.\n                    </p>\n                    <div class=\"mt-4 overflow-hidden rounded-2xl border border-[#DCE5F0] bg-white\" data-kid=\"1-5-3-2-2-4\">\n                        <div class=\"flex items-center gap-3 border-b border-[#E5EBF3] p-4\" data-kid=\"1-5-3-2-2-4-1\">\n                            <div class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#EAF1FA]\" data-kid=\"1-5-3-2-2-4-1-1\">\n                                <i class=\"ti ti-user text-[20px] text-[#153E78]\" data-kid=\"1-5-3-2-2-4-1-1-1\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-5-3-2-2-4-1-2\">\n                                <div class=\"text-[12px] font-bold text