solute bottom-0 flex h-[58px] w-full items-center justify-around border-t border-[#DCE5F0] bg-white\" data-kid=\"1-3-7-2-4\">\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-7-2-4-1\">\n                        <i class=\"ti ti-home-2 block text-[17px]\" data-kid=\"1-3-7-2-4-1-1\">\n                        </i>\n                        Home\n                    </div>\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-7-2-4-2\">\n                        <i class=\"ti ti-scan block text-[17px]\" data-kid=\"1-3-7-2-4-2-1\">\n                        </i>\n                        Scan\n                    </div>\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-7-2-4-3\">\n                        <i class=\"ti ti-history block text-[17px]\" data-kid=\"1-3-7-2-4-3-1\">\n                        </i>\n                        History\n                    </div>\n                    <div class=\"text-center text-[11px] font-bold text-[#0F1199]\" data-kid=\"1-3-7-2-4-4\">\n                        <i class=\"ti ti-user block text-[17px]\" data-kid=\"1-3-7-2-4-4-1\">\n                        </i>\n                        Profile\n                    </div>\n                </div>\n            </div>\n        </article>\n    </div>\n    <section class=\"mt-5 rounded-[18px] border border-[#DCE5F0] bg-white p-5 shadow-[0_5px_18px_rgba(8,27,58,0.05)]\" data-kid=\"1-4\">\n        <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-4-1\">\n            <div class=\"min-w-[310px]\" data-kid=\"1-4-1-1\">\n                <div class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-[#0F1199]\" data-kid=\"1-4-1-1-1\">\n                    Shared palette\n                </div>\n                <div class=\"mt-1 text-[13px] text-[#596A80]\" data-kid=\"1-4-1-1-2\">\n                    Navy leads, white carries the working surface; color signals state