10px] font-bold text-[#286346]\" data-kid=\"1-3-6-2-3-8-1-2\">\n                                Saved\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-3\" data-kid=\"1-3-6-2-3-8-2\">\n                            <div class=\"flex h-[72px] w-[72px] items-center justify-center rounded-[5px] bg-white\" data-dynamic=\"true\" data-kid=\"1-3-6-2-3-8-2-1\" data-name=\"teacher QR code container\" data-reason=\"QR code generated and injected by library\" id=\"teacher-qr\">\n                            </div>\n                            <div class=\"flex-1 text-[11px] leading-[16px] text-[#63738A]\" data-kid=\"1-3-6-2-3-8-2-2\">\n                                This QR contains the event details. Students scan it with the Scan tab.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"absolute bottom-0 flex h-[58px] w-full items-center justify-around border-t border-[#DCE5F0] bg-white\" data-kid=\"1-3-6-2-4\">\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-6-2-4-1\">\n                        <i class=\"ti ti-home-2 block text-[17px]\" data-kid=\"1-3-6-2-4-1-1\">\n                        </i>\n                        Home\n                    </div>\n                    <div class=\"text-center text-[11px] font-bold text-[#0F1199]\" data-kid=\"1-3-6-2-4-2\">\n                        <i class=\"ti ti-clipboard-plus block text-[17px]\" data-kid=\"1-3-6-2-4-2-1\">\n                        </i>\n                        Create\n                    </div>\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-6-2-4-3\">\n                        <i class=\"ti ti-history block text-[17px]\" data-kid=\"1-3-6-2-4-3-1\">\n                        </i>\n                        History\n                    </div>\n                    <div class=\"text-center text-[11px] text-[#72829A]\" data-kid=\"1-3-6-2-4-4\">\n                        <i class=\"ti ti-user block text-[17px]\" data-kid=\"1-3-6-2-4-4-1\">\n                        </i>\n                        Profile\n                    </div>\n                </div>\n            </div>\n        </article>\n        <!-- 07 PROFILE -->\n        <article class=\"rounded-[18px] border border-[#DCE5F0] bg-white p-3 shadow-[0_5px_18px_rgba(8,27,58,0.05)]\" data-kid=\"1-3-7\">\n            <div class=\"mb-2 flex items-center justify-between px-1\" data-kid=\"1-3-7-1\">\n                <span class=\"text-[11px] font-bold uppercase tracking-[0.13em] text-[#0F1199]\" data-kid=\"1-3-7-1-1\">\n                    07 · Profile\n                </span>\n                <span class=\"text-[11px] font-medium text-[#76859A]\" data-kid=\"1-3-7-1-2\">\n                    Account first\n                </span>\n            </div>\n            <div class=\"relative h-[626px] overflow-hidden rounded-[18px] border border-[#D9E2EE] bg-[#F8FAFD]\" data-kid=\"1-3-7-2\">\n                <div class=\"flex h-7 items-center justify-between bg-[#081B3A] px-4 text-[11px] font-semibold text-white\" data-kid=\"1-3-7-2-1\">\n                    <span data-kid=\"1-3-7-2-1-1\">\n                        9:41\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-3-7-2-1-2\">\n                        <i class=\"ti ti-wifi text-[13px] text-white\" data-kid=\"1-3-7-2-1-2-1\">\n                        </i>\n                        <i class=\"ti ti-battery-3 text-[14px] text-white\" data-kid=\"1-3-7-2-1-2-2\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"bg-[#081B3A] px-4 pb-4 pt-4 text-white\" data-kid=\"1-3-7-2-2\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-white/65\" data-kid=\"1-3-7-2-2-1\">\n                       