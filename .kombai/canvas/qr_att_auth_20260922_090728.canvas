      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n</style>\n<script src=\"https://unpkg.com/ionicons@7.4.0/dist/ionicons/ionicons.esm.js\" type=\"module\">\n</script>\n<script nomodule=\"\" src=\"https://unpkg.com/ionicons@7.4.0/dist/ionicons/ionicons.js\">\n</script>\n<div class=\"m-0 w-[375px] bg-[#000000] px-0 py-5 text-[#0D1B2A]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Inter', sans-serif;\">\n    <section aria-label=\"Sign In screen\" class=\"relative mx-auto h-[812px] w-[375px] overflow-hidden rounded-[28px] bg-[#02040A] shadow-[0_18px_50px_rgba(21,52,192,0.18)]\" data-kid=\"1-1\" data-name=\"sign in screen section\">\n        <div class=\"absolute left-5 top-4 z-20 rounded-full border border-white/25 bg-[#0d2eaa]/45 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.22em] text-white/85\" data-kid=\"1-1-1\" data-name=\"step indicator text\">\n            01 · Sign In\n        </div>\n        <div class=\"absolute inset-x-0 top-0 h-[302px] bg-gradient-to-br from-[#02040A] via-[#071642] to-[#0C2D76]\" data-kid=\"1-1-2\" data-name=\"hero background gradient\">\n        </div>\n        <div class=\"absolute -right-14 top-[-42px] h-56 w-56 rounded-full border-[24px] border-white/10\" data-kid=\"1-1-3\" data-name=\"decorative background circle\">\n        </div>\n        <div class=\"absolute -left-20 top-[126px] h-48 w-48 rounded-full border-[20px] border-white/8\" data-kid=\"1-1-4\" data-name=\"secondary decorative background circle\">\n        </div>\n        <div class=\"absolute left-0 right-0 top-12 flex flex-col items-center text-center\" data-kid=\"1-1-5\" data-name=\"app branding container\">\n            <div class=\"rounded-[27px] bg-black p-1 shadow-[0_12px_28px_rgba(6,23,92,0.34)]\" data-kid=\"1-1-5-1\" data-name=\"app icon container\">\n                <img alt=\"QR-ATT icon\" class=\"h-[92px] w-[92px] rounded-[23px] object-cover\" data-kid=\"1-1-5-1-1\" data-name=\"app icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n            </div>\n            <div class=\"mt-3 text-[25px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-1-5-2\" data-name=\"app name text\">\n                QR-ATT\n            </div>\n            <div class=\"mt-1 text-[12px] font-medium tracking-[0.03em] text-blue-100\" data-kid=\"1-1-5-3\" data-name=\"app description text\">\n                QR Attendance System\n            </div>\n        </div>\n        <div class=\"absolute left-4 right-4 top-[246px] rounded-[25px] bg-white px-5 pb-6 pt-5 shadow-[0_18px_38px_rgba(13,71,161,0.18)]\" data-kid=\"1-1-6\" data-name=\"login form container\">\n            <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-1-6-1\" data-name=\"form header\">\n                <div data-kid=\"1-1-6-1-1\" data-name=\"welcome text\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#1534c0]\" data-kid=\"1-1-6-1-1-1\" data-name=\"welcome label\">\n                        Welcome\n                    </div>\n                    <div class=\"mt-1 text-[20px] font-bold tracking-[-0.025em] text-[#0D1B2A]\" data-kid=\"1-1-6-1-1-2\" data-name=\"instruction text\">\n                        Sign in to continue\n                    </div>\n                </div>\n                <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#e3f2fd] text-[20px] text-[#1534c0]\" data-kid=\"1-1-6-1-2\" data-name=\"lock icon container\">\n                    <ion-icon data-kid=\"1-1-6-1-2-1\" data-name=\"lock icon\" name=\"lock-closed-outline\" style=\"width:20px;height:20px;color:#1534c0\">\n                    </ion-icon>\n                </div>\n            </div>\n            <label class=\"mb-2 block text-[12px] font-semibold text-[#27364c]\" data-kid=\"1-1-6-2\" data-name=\"username label\">\n                Username\n            </label>\n            <div class=\"mb-3 flex h-[48px] items-center rounded-[14px] border border-[#c6d8f7] bg-[#f7faff] px-3 ring-2 ring-[#dceaff]\" data-kid=\"1-1-6-3\" data-name=\"username input field container\">\n                <ion-icon data-kid=\"1-1-6-3-1\" data-name=\"person icon\" name=\"person-outline\" style=\"width:18px;height:18px;color:#1534c0\">\n                </ion-icon>\n                <span class=\"ml-2 text-[14px] font-medium text-[#0D1B2A]\" data-kid=\"1-1-6-3-2\" data-name=\"username text\">\n                    admin\n                </span>\n            </div>\n            <label class=\"mb-2 block text-[12px] font-semibold text-[#27364c]\" data-kid=\"1-1-6-4\" data-name=\"password label\">\n                Password\n            </label>\n            <div class=\"flex h-[48px] items-center rounded-[14px] border border-[#c6d8f7] bg-[#f7faff] px-3 ring-2 ring-[#dceaff]\" data-kid=\"1-1-6-5\" data-name=\"password input field container\">\n                <ion-icon data-kid=\"1-1-6-5-1\" data-name=\"key icon\" name=\"key-outline\" style=\"width:18px;height:18px;color:#1534c0\">\n                </ion-icon>\n                <span class=\"ml-2 flex-1 text-[14px] font-medium tracking-[0.22em] text-[#0D1B2A]\" data-kid=\"1-1-6-5-2\" data-name=\"password mask text\">\n                    ••••••\n                </span>\n                <button aria-label=\"Show password\" class=\"flex h-8 w-8 items-center justify-center rounded-full text-[19px] text-[#55708e]\" data-kid=\"1-1-6-5-3\" data-name=\"show password button\" type=\"button\">\n                    <ion-icon data-kid=\"1-1-6-5-3-1\" data-name=\"eye icon\" name=\"eye-outline\" style=\"width:19px;height:19px;color:#55708e\">\n                    </ion-icon>\n                </button>\n            </div>\n            <div class=\"mt-3 flex items-center gap-2 rounded-[11px] border border-[#ffd9d5] bg-[#fff7f6] px-3 py-2 text-[11px] font-medium text-[#bd3f38]\" data-kid=\"1-1-6-6\" data-name=\"error message container\" role=\"alert\">\n                <ion-icon data-kid=\"1-1-6-6-1\" data-name=\"alert icon\" name=\"alert-circle-outline\" style=\"width:15px;height:15px;color:#bd3f38\">\n                </ion-icon>\n                <span data-kid=\"1-1-6-6-2\" data-name=\"error text\">\n                    Invalid username or password.\n                </span>\n            </div>\n            <button class=\"mt-4 flex h-[52px] w-full items-center justify-center gap-2 rounded-[15px] bg-[#1534c0] text-[15px] font-bold text-white shadow-[0_10px_22px_rgba(21,52,192,0.25)]\" data-kid=\"1-1-6-7\" data-name=\"sign in button\" type=\"button\">\n                <span data-kid=\"1-1-6-7-1\" data-name=\"button label text\">\n                    Sign In\n                </span>\n                <ion-icon data-kid=\"1-1-6-7-2\" data-name=\"arrow forward icon\" name=\"arrow-forward-outline\" style=\"width:19px;height:19px;color:#ffffff\">\n                </ion-icon>\n            </button>\n        </div>\n        <div class=\"absolute bottom-6 left-0 right-0 text-center text-[10px] font-medium tracking-[0.05em] text-[#6b7f99]\" data-kid=\"1-1-7\" data-name=\"footer help text\">\n            Simple local access for QR-ATT\n        </div>\n    </section>\n    <section aria-label=\"Signed-in dashboard with sign-out confirmation\" class=\"relative mx-auto mt-7 h-[812px] w-[375px] overflow-hidden rounded-[28px] bg-[#02040A] shadow-[0_18px_50px_rgba(21,52,192,0.18)]\" data-kid=\"1-2\" data-name=\"dashboard screen section\">\n        <div class=\"absolute left-5 top-4 z-20 rounded-full border border-white/25 bg-[#0d2eaa]/45 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.2em] text-white/85\" data-kid=\"1-2-1\" data-name=\"step indicator text\">\n            02 · Signed In\n        </div>\n        <div class=\"absolute inset-x-0 top-0 h-[214px] bg-gradient-to-br from-[#102b9f] via-[#1534c0] to-[#2b73f2]\" data-kid=\"1-2-2\" data-name=\"hero background gradient\">\n        </div>\n        <div class=\"absolute -right-16 top-[-62px] h-64 w-64 rounded-full border-[26px] border-white/10\" data-kid=\"1-2-3\" data-name=\"decorative background circle\">\n        </div>\n        <div class=\"absolute left-5 right-5 top-[55px] flex items-center\" data-kid=\"1-2-4\" data-name=\"user profile header\">\n            <div class=\"rounded-[17px] bg-black p-1 shadow-[0_8px_18px_rgba(6,23,92,0.28)]\" data-kid=\"1-2-4-1\" data-name=\"user icon container\">\n                <img alt=\"QR-ATT icon\" class=\"h-[54px] w-[54px] rounded-[13px] object-cover\" data-kid=\"1-2-4-1-1\" data-name=\"user icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n            </div>\n            <div class=\"ml-3\" data-kid=\"1-2-4-2\" data-name=\"user greeting container\">\n                <div class=\"text-[20px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-2-4-2-1\" data-name=\"user app name\">\n                    QR-ATT\n                </div>\n                <div class=\"text-[10px] font-medium text-blue-100\" data-kid=\"1-2-4-2-2\" data-name=\"user app description\">\n                    QR Attendance System\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute left-5 top-[143px] text-white\" data-kid=\"1-2-5\" data-name=\"welcome greeting\">\n            <div class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-blue-100\" data-kid=\"1-2-5-1\" data-name=\"welcome label\">\n                Welcome\n            </div>\n            <div class=\"mt-1 text-[24px] font-bold tracking-[-0.035em]\" data-kid=\"1-2-5-2\" data-name=\"username text\">\n                admin\n            </div>\n        </div>\n        <div class=\"absolute left-4 right-4 top-[187px] rounded-[25px] bg-white px-5 pb-5 pt-6 shadow-[0_18px_38px_rgba(13,71,161,0.18)]\" data-kid=\"1-2-6\" data-name=\"dashboard actions container\">\n            <div class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#1534c0]\" data-kid=\"1-2-6-1\" data-name=\"dashboard label\">\n                Dashboard\n            </div>\n            <div class=\"mt-1 text-[20px] font-bold tracking-[-0.025em] text-[#0D1B2A]\" data-kid=\"1-2-6-2\" data-name=\"page title\">\n                School Event Attendance\n            </div>\n            <div class=\"mt-1 text-[12px] leading-[18px] text-[#62728a]\" data-kid=\"1-2-6-3\" data-name=\"page description\">\n                Scan QR Codes to record attendance during school activities.\n            </div>\n            <button class=\"mt-5 flex h-[56px] w-full items-center justify-center gap-3 rounded-[16px] bg-[#1534c0] text-[15px] font-bold text-white shadow-[0_10px_22px_rgba(21,52,192,0.25)]\" data-kid=\"1-2-6-4\" data-name=\"scan qr button\" type=\"button\">\n                <ion-icon data-kid=\"1-2-6-4-1\" data-name=\"qr code icon\" name=\"qr-code-outline\" style=\"width:22px;height:22px;color:#ffffff\">\n                </ion-icon>\n                <span data-kid=\"1-2-6-4-2\" data-name=\"scan qr button text\">\n                    Scan QR Code\n                </span>\n            </button>\n            <button class=\"mt-3 flex h-[50px] w-full items-center justify-center gap-3 rounded-[15px] border border-[#d6e1f1] bg-[#ffffff] text-[14px] font-semibold text-[#0D1B2A]\" data-kid=\"1-2-6-5\" data-name=\"attendance history button\" type=\"button\">\n                <ion-icon data-kid=\"1-2-6-5-1\" data-name=\"time icon\" name=\"time-outline\" style=\"width:20px;height:20px;color:#1534c0\">\n                </ion-icon>\n                <span data-kid=\"1-2-6-5-2\" data-name=\"history button text\">\n                    Attendance History\n                </span>\n            </button>\n            <button class=\"mt-3 flex h-[50px] w-full items-center justify-center gap-3 rounded-[15px] border border-[#d6e1f1] bg-[#ffffff] text-[14px] font-semibold text-[#0D1B2A]\" data-kid=\"1-2-6-6\" data-name=\"profile button\" type=\"button\">\n                <ion-icon data-kid=\"1-2-6-6-1\" data-name=\"person icon\" name=\"person-outline\" style=\"width:20px;height:20px;color:#1534c0\">\n                </ion-icon>\n                <span data-kid=\"1-2-6-6-2\" data-name=\"profile button text\">\n                    Profile\n                </span>\n            </button>\n            <div class=\"my-4 h-px bg-[#edf1f7]\" data-kid=\"1-2-6-7\" data-name=\"divider\">\n            </div>\n            <button class=\"flex h-[43px] w-full items-center justify-center gap-2 rounded-[13px] bg-[#f1f6ff] text-[13px] font-bold text-[#1534c0]\" data-kid=\"1-2-6-8\" data-name=\"sign out button\" type=\"button\">\n                <ion-icon data-kid=\"1-2-6-8-1\" data-name=\"log out icon\" name=\"log-out-outline\" style=\"width:18px;height:18px;color:#1534c0\">\n                </ion-icon>\n                <span data-kid=\"1-2-6-8-2\" data-name=\"sign out button text\">\n                    Sign Out\n                </span>\n            </button>\n        </div>\n        <div class=\"absolute inset-0 z-30 bg-[#0d1b2a]/30\" data-kid=\"1-2-7\" data-name=\"modal backdrop overlay\">\n        </div>\n        <div class=\"absolute bottom-5 left-4 right-4 z-40 rounded-[24px] bg-white p-5 shadow-[0_20px_48px_rgba(13,27,42,0.28)]\" data-kid=\"1-2-8\" data-name=\"sign out confirmation modal\">\n            <div class=\"mb-3 flex items-start gap-3\" data-kid=\"1-2-8-1\" data-name=\"modal header\">\n                <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#e3f2fd] text-[21px] text-[#1534c0]\" data-kid=\"1-2-8-1-1\" data-name=\"icon container\">\n                    <ion-icon data-kid=\"1-2-8-1-1-1\" data-name=\"log out icon\" name=\"log-out-outline\" style=\"width:21px;height:21px;color:#1534c0\">\n                    </ion-icon>\n                </div>\n                <div data-kid=\"1-2-8-1-2\" data-name=\"modal message text\">\n                    <div class=\"text-[16px] font-bold text-[#0D1B2A]\" data-kid=\"1-2-8-1-2-1\" data-name=\"modal title\">\n                        Sign Out\n                    </div>\n                    <div class=\"mt-1 text-[13px] leading-[19px] text-[#62728a]\" data-kid=\"1-2-8-1-2-2\" data-name=\"modal body text\">\n                        Are you sure you want to sign out?\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 grid grid-cols-2 gap-3\" data-kid=\"1-2-8-2\" data-name=\"modal buttons container\">\n                <button class=\"h-[46px] rounded-[13px] border border-[#d6e1f1] bg-white text-[13px] font-bold text-[#51657f]\" data-kid=\"1-2-8-2-1\" data-name=\"cancel button\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"h-[46px] rounded-[13px] bg-[#1534c0] text-[13px] font-bold text-white shadow-[0_8px_16px_rgba(21,52,192,0.2)]\" data-kid=\"1-2-8-2-2\" data-name=\"confirm sign out button\" type=\"button\">\n                    Sign Out\n                </button>\n            </div>\n        </div>\n    </section>\n</div>\n",
