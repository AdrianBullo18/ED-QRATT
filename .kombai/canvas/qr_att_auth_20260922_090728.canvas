        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap');\n  .qr-flow { font-family: 'DM Sans', sans-serif; }\n  .qr-display { font-family: 'Manrope', sans-serif; }\n</style>\n<script src=\"https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js\" type=\"module\">\n</script>\n<div class=\"qr-flow w-full min-h-[1640px] bg-[#000000] px-0 pb-10 text-[#0D1B2A]\" data-kid=\"1\" data-name=\"qr-att authentication and dashboard flow\">\n    <div class=\"px-5 pt-5 pb-3\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"top bar container\">\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#1534C0]\" data-kid=\"1-1-1-1\" data-name=\"brand name label\">\n                QR-ATT • Auth flow\n            </span>\n            <span class=\"rounded-full bg-white px-2.5 py-1 text-[10px] font-semibold text-[#52709B] shadow-sm\" data-kid=\"1-1-1-2\" data-name=\"page identifier pill\">\n                Mobile reference\n            </span>\n        </div>\n    </div>\n    <section class=\"px-0\" data-kid=\"1-2\" data-name=\"sign-in section\">\n        <div class=\"px-5 pb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#52709B]\" data-kid=\"1-2-1\" data-name=\"section title label\">\n            01 / Sign in\n        </div>\n        <div class=\"relative h-[700px] overflow-hidden bg-[#1534C0] px-5 pt-7\" data-kid=\"1-2-2\" data-name=\"sign-in card container\">\n            <div class=\"relative mx-auto w-full max-w-[335px] rounded-[28px] bg-white px-5 pb-6 pt-7 shadow-[0_18px_42px_rgba(13,71,161,0.28)]\" data-kid=\"1-2-2-3\" data-name=\"login form card\">\n                <div class=\"flex flex-col items-center\" data-kid=\"1-2-2-3-1\" data-name=\"brand logo and title group\">\n                    <div class=\"flex h-[86px] w-[86px] items-center justify-center overflow-hidden rounded-[24px] border-[5px] border-[#E3F2FD] bg-black shadow-[0_10px_22px_rgba(13,71,161,0.18)]\" data-kid=\"1-2-2-3-1-1\" data-name=\"logo wrapper\">\n                        <img alt=\"QR-ATT icon\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"app logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                    </div>\n                    <div class=\"qr-display mt-4 text-[25px] font-extrabold tracking-[-0.04em] text-[#0D1B2A]\" data-kid=\"1-2-2-3-1-2\" data-name=\"brand display name\">\n                        QR-ATT\n                    </div>\n                    <div class=\"mt-1 text-[13px] font-medium text-[#52709B]\" data-kid=\"1-2-2-3-1-3\" data-name=\"app description\">\n                        QR Attendance System\n                    </div>\n                </div>\n                <div class=\"mt-7 space-y-4\" data-kid=\"1-2-2-3-2\" data-name=\"form fields container\">\n                    <label class=\"block\" data-kid=\"1-2-2-3-2-1\" data-name=\"username field group\">\n                        <span class=\"mb-2 block text-[12px] font-bold uppercase tracking-[0.08em] text-[#0D1B2A]\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"username field label\">\n                            Username\n                        </span>\n                        <div class=\"flex h-[52px] items-center gap-3 rounded-[15px] border border-[#D6E2F0] bg-[#F8FBFF] px-4 shadow-[0_2px_6px_rgba(13,71,161,0.04)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"username input field container\">\n                            <ion-icon data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"username user icon\" name=\"person-outline\" style=\"font-size:20px;color:#1534C0\">\n                            </ion-icon>\n                            <span class=\"flex-1 text-[15px] font-semibold text-[#0D1B2A]\" data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"username input text\">\n                                admin\n                            </span>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-2-2-3-2-2\" data-name=\"password field group\">\n                        <span class=\"mb-2 block text-[12px] font-bold uppercase tracking-[0.08em] text-[#0D1B2A]\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"password field label\">\n                            Password\n                        </span>\n                        <div class=\"flex h-[52px] items-center gap-3 rounded-[15px] border border-[#D6E2F0] bg-[#F8FBFF] px-4 shadow-[0_2px_6px_rgba(13,71,161,0.04)]\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"password input field container\">\n                            <ion-icon data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"password lock icon\" name=\"lock-closed-outline\" style=\"font-size:20px;color:#1534C0\">\n                            </ion-icon>\n                            <span class=\"flex-1 text-[16px] font-semibold tracking-[0.26em] text-[#0D1B2A]\" data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"password masked text\">\n                                ••••••\n                            </span>\n                            <ion-icon data-kid=\"1-2-2-3-2-2-2-3\" data-name=\"password visibility icon\" name=\"eye-outline\" style=\"font-size:21px;color:#52709B\">\n                            </ion-icon>\n                        </div>\n                    </label>\n                    <div class=\"flex items-center gap-2 rounded-[12px] bg-[#E3F2FD] px-3 py-2.5 text-[11px] font-medium text-[#1534C0]\" data-kid=\"1-2-2-3-2-3\" data-name=\"demo access information box\">\n                        <ion-icon data-kid=\"1-2-2-3-2-3-1\" data-name=\"information icon\" name=\"information-circle-outline\" style=\"font-size:17px;color:#1534C0\">\n                        </ion-icon>\n                        <span data-kid=\"1-2-2-3-2-3-2\" data-name=\"demo access label text\">\n                            Demo access:\n                            <strong data-kid=\"1-2-2-3-2-3-2-1\" data-name=\"admin username bold text\">\n                                admin\n                            </strong>\n                            /\n                            <strong data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"demo password bold text\">\n                                123456\n                            </strong>\n                        </span>\n                    </div>\n                    <div class=\"flex h-[54px] items-center justify-center gap-2 rounded-[16px] bg-[#1534C0] text-[16px] font-bold text-white shadow-[0_9px_18px_rgba(21,52,192,0.28)]\" data-kid=\"1-2-2-3-2-4\" data-name=\"primary sign in button\">\n                        <span data-kid=\"1-2-2-3-2-4-1\" data-name=\"sign in button text\">\n                            Sign In\n                        </span>\n                        <ion-icon data-kid=\"1-2-2-3-2-4-2\" data-name=\"forward arrow icon\" name=\"arrow-forward\" style=\"font-size:19px;color:#FFFFFF\">\n                        </ion-icon>\n                    </div>\n                </div>\n                <div class=\"mt-6 text-center text-[11px] font-medium text-[#7B8FA8]\" data-kid=\"1-2-2-3-3\" data-name=\"local demo sign in disclaimer\">\n                    Local demo sign in\n                </div>\n            </div>\n        </div>\n    </section>\n    <div class=\"h-8\" data-kid=\"1-3\" data-name=\"spacer element\">\n    </div>\n    <section class=\"px-0\" data-kid=\"1-4\" data-name=\"dashboard section\">\n        <div class=\"px-5 pb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#9EB7D8]\" data-kid=\"1-4-1\" data-name=\"dashboard section title label\">\n            02 / Dashboard + sign-out alert\n        </div>\n        <div class=\"relative h-[800px] overflow-hidden bg-[#08152E] px-5 pb-5 pt-7\" data-kid=\"1-4-2\" data-name=\"dashboard view container\">\n            <div class=\"relative z-10 flex items-start justify-between\" data-kid=\"1-4-2-1\" data-name=\"user header bar\">\n                <div data-kid=\"1-4-2-1-1\" data-name=\"welcome message container\">\n                    <div class=\"text-[11px] font-bold uppercase tracking-[0.12em] text-[#9EB7D8]\" data-kid=\"1-4-2-1-1-1\" data-name=\"brand subtitle\">\n                        QR Attendance System\n                    </div>\n                    <div class=\"qr-display mt-1 text-[25px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-4-2-1-1-2\" data-name=\"welcome greeting text\">\n                        Welcome, admin\n                    </div>\n                </div>\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-[13px] bg-[#E3F2FD] text-[#1534C0]\" data-kid=\"1-4-2-1-2\" data-name=\"profile icon wrapper\">\n                    <ion-icon data-kid=\"1-4-2-1-2-1\" data-name=\"profile circle icon\" name=\"person-circle-outline\" style=\"font-size:24px;color:#1534C0\">\n                    </ion-icon>\n                </div>\n            </div>\n            <div class=\"relative z-10 mt-7 rounded-[22px] bg-[#F4F8FF] p-4 shadow-[0_5px_18px_rgba(13,71,161,0.07)]\" data-kid=\"1-4-2-2\" data-name=\"attendance progress card\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-4-2-2-1\" data-name=\"card top bar\">\n                    <div data-kid=\"1-4-2-2-1-1\" data-name=\"attendance title container\">\n                        <div class=\"text-[11px] font-bold uppercase tracking-[0.11em] text-[#52709B]\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"card status label\">\n                            Today\n                        </div>\n                        <div class=\"mt-1 text-[18px] font-bold text-[#0D1B2A]\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"attendance event name\">\n                            School Event Attendance\n                        </div>\n                    </div>\n                    <div class=\"flex h-11 w-11 items-center justify-center rounded-[14px] bg-[#1534C0] text-white\" data-kid=\"1-4-2-2-1-2\" data-name=\"attendance checkmark icon wrapper\">\n                        <ion-icon data-kid=\"1-4-2-2-1-2-1\" data-name=\"checkmark icon\" name=\"checkmark-done-outline\" style=\"font-size:23px;color:#FFFFFF\">\n                        </ion-icon>\n                    </div>\n                </div>\n                <div class=\"mt-4 h-2 overflow-hidden rounded-full bg-[#D8E6F8]\" data-kid=\"1-4-2-2-2\" data-name=\"progress track container\">\n                    <div class=\"h-full w-[72%] rounded-full bg-[#1534C0]\" data-kid=\"1-4-2-2-2-1\" data-name=\"progress bar indicator\">\n                    </div>\n                </div>\n                <div class=\"mt-2 text-[11px] font-medium text-[#52709B]\" data-kid=\"1-4-2-2-3\" data-name=\"attendance readiness note\">\n                    Ready to record your attendance\n                </div>\n            </div>\n            <div class=\"relative z-10 mt-5 space-y-3\" data-kid=\"1-4-2-3\" data-name=\"navigation menu links\">\n                <div class=\"flex h-[62px] items-center gap-3 rounded-[16px] bg-[#1534C0] px-4 text-white shadow-[0_8px_18px_rgba(21,52,192,0.22)]\" data-kid=\"1-4-2-3-1\" data-name=\"scan qr code button\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-white/15\" data-kid=\"1-4-2-3-1-1\" data-name=\"scan icon wrapper\">\n                        <ion-icon data-kid=\"1-4-2-3-1-1-1\" data-name=\"qr code icon\" name=\"qr-code-outline\" style=\"font-size:21px;color:#FFFFFF\">\n                        </ion-icon>\n                    </div>\n                    <span class=\"flex-1 text-[15px] font-bold\" data-kid=\"1-4-2-3-1-2\" data-name=\"scan button text\">\n                        Scan QR Code\n                    </span>\n                    <ion-icon data-kid=\"1-4-2-3-1-3\" data-name=\"chevron forward icon\" name=\"chevron-forward\" style=\"font-size:19px;color:#FFFFFF\">\n                    </ion-icon>\n                </div>\n                <div class=\"flex h-[62px] items-center gap-3 rounded-[16px] border border-[#E0E8F0] bg-white px-4 text-[#0D1B2A] shadow-[0_3px_12px_rgba(13,71,161,0.06)]\" data-kid=\"1-4-2-3-2\" data-name=\"attendance history button\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-[#E3F2FD] text-[#1534C0]\" data-kid=\"1-4-2-3-2-1\" data-name=\"history icon wrapper\">\n                        <ion-icon data-kid=\"1-4-2-3-2-1-1\" data-name=\"history time icon\" name=\"time-outline\" style=\"font-size:21px;color:#1534C0\">\n                        </ion-icon>\n                    </div>\n                    <span class=\"flex-1 text-[15px] font-bold\" data-kid=\"1-4-2-3-2-2\" data-name=\"history button text\">\n                        Attendance History\n                    </span>\n                    <ion-icon data-kid=\"1-4-2-3-2-3\" data-name=\"chevron forward icon\" name=\"chevron-forward\" style=\"font-size:19px;color:#52709B\">\n                    </ion-icon>\n                </div>\n                <div class=\"flex h-[62px] items-center gap-3 rounded-[16px] border border-[#E0E8F0] bg-white px-4 text-[#0D1B2A] shadow-[0_3px_12px_rgba(13,71,161,0.06)]\" data-kid=\"1-4-2-3-3\" data-name=\"profile navigation button\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-[#E3F2FD] text-[#1534C0]\" data-kid=\"1-4-2-3-3-1\" data-name=\"profile icon wrapper\">\n                        <ion-icon data-kid=\"1-4-2-3-3-1-1\" data-name=\"profile icon\" name=\"person-outline\" style=\"font-size:21px;color:#1534C0\">\n                        </ion-icon>\n                    </div>\n                    <span class=\"flex-1 text-[15px] font-bold\" data-kid=\"1-4-2-3-3-2\" data-name=\"profile button text\">\n                        Profile\n                    </span>\n                    <ion-icon data-kid=\"1-4-2-3-3-3\" data-name=\"chevron forward icon\" name=\"chevron-forward\" style=\"font-size:19px;color:#52709B\">\n                    </ion-icon>\n                </div>\n            </div>\n            <div class=\"relative z-10 mt-4 flex h-[48px] items-center justify-center gap-2 rounded-[14px] border border-[#C6D6EE] bg-[#F8FBFF] text-[14px] font-bold text-[#1534C0]\" data-kid=\"1-4-2-4\" data-name=\"sign out button\">\n                <ion-icon data-kid=\"1-4-2-4-1\" data-name=\"logout icon\" name=\"log-out-outline\" style=\"font-size:19px;color:#1534C0\">\n                </ion-icon>\n                <span data-kid=\"1-4-2-4-2\" data-name=\"sign out text\">\n                    Sign Out\n                </span>\n            </div>\n            <div class=\"absolute inset-0 z-20 bg-[#0D1B2A]/42\" data-kid=\"1-4-2-5\" data-name=\"modal overlay background\">\n            </div>\n            <div class=\"absolute left-5 right-5 top-[245px] z-30 rounded-[22px] bg-white p-5 shadow-[0_20px_48px_rgba(13,27,42,0.28)]\" data-kid=\"1-4-2-6\" data-name=\"sign out confirmation modal\">\n                <div class=\"mx-auto mb-4 h-1.5 w-11 rounded-full bg-[#D6E2F0]\" data-kid=\"1-4-2-6-1\" data-name=\"modal drag handle\">\n                </div>\n                <div class=\"flex items-start gap-3\" data-kid=\"1-4-2-6-2\" data-name=\"modal body\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[13px] bg-[#E3F2FD] text-[#1534C0]\" data-kid=\"1-4-2-6-2-1\" data-name=\"modal icon wrapper\">\n                        <ion-icon data-kid=\"1-4-2-6-2-1-1\" data-name=\"logout icon\" name=\"log-out-outline\" style=\"font-size:21px;color:#1534C0\">\n                        </ion-icon>\n                    </div>\n                    <div data-kid=\"1-4-2-6-2-2\" data-name=\"modal text group\">\n                        <div class=\"text-[18px] font-bold text-[#0D1B2A]\" data-kid=\"1-4-2-6-2-2-1\" data-name=\"modal title\">\n                            Sign out?\n                        </div>\n                        <div class=\"mt-1 text-[13px] leading-5 text-[#52709B]\" data-kid=\"1-4-2-6-2-2-2\" data-name=\"modal description\">\n                            Are you sure you want to sign out?\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex gap-3\" data-kid=\"1-4-2-6-3\" data-name=\"modal action button container\">\n                    <div class=\"flex h-[46px] flex-1 items-center justify-center rounded-[13px] border border-[#D6E2F0] text-[14px] font-bold text-[#52709B]\" data-kid=\"1-4-2-6-3-1\" data-name=\"cancel button\">\n                        Cancel\n                    </div>\n                    <div class=\"flex h-[46px] flex-1 items-center justify-center rounded-[13px] bg-[#1534C0] text-[14px] font-bold text-white shadow-[0_6px_14px_rgba(21,52,192,0.22)]\" data-kid=\"1-4-2-6-3-2\" data-name=\"confirm sign out button\">\n                        Sign Out\n                    </div>\n                </div>\n            </div>\n            <div class=\"absolute bottom-0 left-0 right-0 z-10 flex h-[70px] items-end justify-around border-t border-[#E0E8F0] bg-white px-1 pb-3 pt-2\" data-kid=\"1-4-2-7\" data-name=\"bottom navigation bar\">\n                <div class=\"flex flex-col items-center gap-1 text-[#1534C0]\" data-kid=\"1-4-2-7-1\" data-name=\"navigation tab 1 active\">\n                    <ion-icon data-kid=\"1-4-2-7-1-1\" data-name=\"home icon\" name=\"home\" style=\"font-size:20px;color:#1534C0\">\n                    </ion-icon>\n                    <span class=\"text-[9px] font-bold\" data-kid=\"1-4-2-7-1-2\" data-name=\"home label\">\n                        Home\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-1 text-[#7B8FA8]\" data-kid=\"1-4-2-7-2\" data-name=\"navigation tab 2\">\n                    <ion-icon data-kid=\"1-4-2-7-2-1\" data-name=\"scan icon\" name=\"qr-code-outline\" style=\"font-size:20px;color:#7B8FA8\">\n                    </ion-icon>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-4-2-7-2-2\" data-name=\"scan label\">\n                        Scan\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-1 text-[#7B8FA8]\" data-kid=\"1-4-2-7-3\" data-name=\"navigation tab 3\">\n                    <ion-icon data-kid=\"1-4-2-7-3-1\" data-name=\"history icon\" name=\"time-outline\" style=\"font-size:20px;color:#7B8FA8\">\n                    </ion-icon>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-4-2-7-3-2\" data-name=\"history label\">\n                        History\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-1 text-[#7B8FA8]\" data-kid=\"1-4-2-7-4\" data-name=\"navigation tab 4\">\n                    <ion-icon data-kid=\"1-4-2-7-4-1\" data-name=\"profile icon\" name=\"person-outline\" style=\"font-size:20px;color:#7B8FA8\">\n                    </ion-icon>\n                    <span class=\"text-[9px] font-semibold\" data-kid=\"1-4-2-7-4-2\" data-name=\"profile label\">\n                        Profile\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n",
