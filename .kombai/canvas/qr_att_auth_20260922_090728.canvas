      "html": "<div class=\"min-h-screen w-full bg-[#000000] px-3 py-4 text-[#0D1B2A]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n    <div class=\"space-y-2\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n        <div class=\"flex items-center gap-2 px-1\" data-kid=\"1-1-1\" data-name=\"section header container\">\n            <span class=\"h-1.5 w-1.5 rounded-full bg-[#1534c0]\" data-kid=\"1-1-1-1\" data-name=\"decorative circle icon\">\n            </span>\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#1534c0]\" data-kid=\"1-1-1-2\" data-name=\"section label\">\n                01 / Sign In\n            </span>\n        </div>\n        <section class=\"relative flex min-h-[812px] w-full flex-col overflow-hidden rounded-[28px] border border-white/50 px-5 py-8 shadow-[0_18px_45px_rgba(13,71,161,0.18)]\" data-kid=\"1-1-2\" data-name=\"login screen container\" style=\"background: linear-gradient(180deg, #071642 0%, #0C2D76 100%);\">\n            <div class=\"pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full border border-white/15\" data-kid=\"1-1-2-1\" data-name=\"decorative background circle\">\n            </div>\n            <div class=\"pointer-events-none absolute -left-24 top-36 h-52 w-52 rounded-full border border-white/10\" data-kid=\"1-1-2-2\" data-name=\"decorative background circle\">\n            </div>\n            <div class=\"relative z-10 flex flex-1 flex-col items-center justify-center\" data-kid=\"1-1-2-3\" data-name=\"login form content container\">\n                <div class=\"mb-5 flex h-[92px] w-[92px] items-center justify-center overflow-hidden rounded-[26px] border border-white/70 bg-white shadow-[0_12px_26px_rgba(13,27,42,0.22)]\" data-kid=\"1-1-2-3-1\" data-name=\"logo image container\">\n                    <img alt=\"QR-ATT icon\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-3-1-1\" data-name=\"app logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/images/icon.png\"/>\n                </div>\n                <h1 class=\"text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-1-2-3-2\" data-name=\"app title\">\n                    QR-ATT\n                </h1>\n                <p class=\"mt-1 text-[13px] font-medium tracking-[0.02em] text-white/80\" data-kid=\"1-1-2-3-3\" data-name=\"app description\">\n                    QR Attendance System\n                </p>\n                <div class=\"mt-8 w-full rounded-[24px] border border-white/70 bg-white/95 p-5 shadow-[0_16px_30px_rgba(13,27,42,0.18)] backdrop-blur-xl\" data-kid=\"1-1-2-3-4\" data-name=\"login input form\">\n                    <div class=\"mb-5\" data-kid=\"1-1-2-3-4-1\" data-name=\"form header\">\n                        <p class=\"text-[20px] font-bold tracking-[-0.02em] text-[#0D1B2A]\" data-kid=\"1-1-2-3-4-1-1\" data-name=\"form title\">\n                            Sign In\n                        </p>\n                    </div>\n                    <label class=\"mb-2 block text-[12px] font-bold uppercase tracking-[0.12em] text-[#0D1B2A]/60\" data-kid=\"1-1-2-3-4-2\" data-name=\"username label\">\n                        Username\n                    </label>\n                    <div class=\"mb-4 flex h-12 items-center rounded-[14px] border border-[#E0E8F0] bg-[#F7FBFF] px-4 shadow-[0_3px_10px_rgba(13,71,161,0.05)]\" data-kid=\"1-1-2-3-4-3\" data-name=\"username input field display\">\n                        <span class=\"mr-3 text-[16px] text-[#1534c0]\" data-kid=\"1-1-2-3-4-3-1\" data-name=\"username icon\">\n                            @\n                        </span>\n                        <span class=\"text-[15px] font-semibold text-[#0D1B2A]\" data-kid=\"1-1-2-3-4-3-2\" data-name=\"username text\">\n                            admin\n                        </span>\n                    </div>\n                    <label class=\"mb-2 block text-[12px] font-bold uppercase tracking-[0.12em] text-[#0D1B2A]/60\" data-kid=\"1-1-2-3-4-4\" data-name=\"password label\">\n                        Password\n                    </label>\n                    <div class=\"flex h-12 items-center rounded-[14px] border border-[#E0E8F0] bg-[#F7FBFF] px-4 shadow-[0_3px_10px_rgba(13,71,161,0.05)]\" data-kid=\"1-1-2-3-4-5\" data-name=\"password input field display\">\n                        <span class=\"mr-3 text-[16px] tracking-[0.2em] text-[#0D1B2A]\" data-kid=\"1-1-2-3-4-5-1\" data-name=\"masked password text\">\n                            ••••••\n                        </span>\n                        <span aria-label=\"Show password\" class=\"ml-auto flex h-8 w-8 items-center justify-center rounded-full text-[#1534c0]\" data-kid=\"1-1-2-3-4-5-2\" data-name=\"show password button\">\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-5-2-1\" data-lucide=\"eye\" data-name=\"eye icon\" data-reason=\"icon rendered by lucide script\">\n                            </i>\n                        </span>\n                    </div>\n                    <button class=\"mt-6 flex h-12 w-full items-center justify-center rounded-[14px] border-[3px] border-[#1534c0] bg-[#1534c0] text-[15px] font-bold text-white shadow-[0_8px_16px_rgba(21,52,192,0.24)]\" data-kid=\"1-1-2-3-4-6\" data-name=\"sign in button\">\n                        Sign In\n                    </button>\n                </div>\n            </div>\n            <p class=\"relative z-10 mt-5 text-center text-[11px] font-medium text-white/65\" data-kid=\"1-1-2-4\" data-name=\"footer hint text\">\n                Simple local access\n            </p>\n        </section>\n        <div class=\"flex items-center gap-2 px-1 pt-4\" data-kid=\"1-1-3\" data-name=\"dashboard header container\">\n            <span class=\"h-1.5 w-1.5 rounded-full bg-[#1534c0]\" data-kid=\"1-1-3-1\" data-name=\"decorative circle icon\">\n            </span>\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#1534c0]\" data-kid=\"1-1-3-2\" data-name=\"section label\">\n                02 / Signed-in Dashboard\n            </span>\n        </div>\n        <section class=\"relative min-h-[812px] w-full overflow-hidden rounded-[28px] border border-[#0C2D76] bg-[#02040A] shadow-[0_18px_45px_rgba(13,71,161,0.14)]\" data-kid=\"1-1-4\" data-name=\"dashboard screen container\">\n            <div class=\"h-[164px] rounded-b-[30px] px-5 pb-6 pt-8\" data-kid=\"1-1-4-1\" data-name=\"dashboard top header\" style=\"background: linear-gradient(180deg, #02040A 0%, #0C2D76 100%);\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-1-4-1-1\" data-name=\"header information container\">\n                    <div data-kid=\"1-1-4-1-1-1\" data-name=\"user info container\">\n                        <p class=\"text-[12px] font-medium uppercase tracking-[0.13em] text-white/70\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"app name label\">\n                            QR-ATT\n                        </p>\n                        <h2 class=\"mt-2 text-[27px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"welcome greeting\">\n                            Welcome\n                        </h2>\n                        <p class=\"mt-1 text-[12px] font-medium text-white/75\" data-kid=\"1-1-4-1-1-1-3\" data-name=\"signed in user status\">\n                            Signed in as admin\n                        </p>\n                    </div>\n                    <div class=\"flex h-10 w-10 items-center justify-center rounded-[14px] border border-white/25 bg-white/15 text-white\" data-kid=\"1-1-4-1-1-2\" data-name=\"scan icon container\">\n                        <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-4-1-1-2-1\" data-lucide=\"scan-line\" data-name=\"scan icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative -mt-4 px-5 pb-5\" data-kid=\"1-1-4-2\" data-name=\"dashboard main content\">\n                <div class=\"rounded-[22px] border border-[#D7E7F6] bg-white p-5 shadow-[0_10px_22px_rgba(13,71,161,0.09)]\" data-kid=\"1-1-4-2-1\" data-name=\"info card\">\n                    <p class=\"text-[18px] font-bold text-[#1534c0]\" data-kid=\"1-1-4-2-1-1\" data-name=\"info card title\">\n                        School Event Attendance\n                    </p>\n                    <p class=\"mt-2 text-[13px] leading-5 text-[#0D1B2A]/60\" data-kid=\"1-1-4-2-1-2\" data-name=\"info card description\">\n                        Scan QR Codes to record attendance during school activities.\n                    </p>\n                </div>\n                <div class=\"mt-5 space-y-3\" data-kid=\"1-1-4-2-2\" data-name=\"action button container\">\n                    <button class=\"flex h-14 w-full items-center justify-center gap-3 rounded-[15px] border-[3px] border-[#1534c0] bg-[#1534c0] text-[15px] font-bold text-white shadow-[0_8px_16px_rgba(21,52,192,0.2)]\" data-kid=\"1-1-4-2-2-1\" data-name=\"scan qr code button\">\n                        <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2-1-1\" data-lucide=\"scan-qr-code\" data-name=\"scan icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                        Scan QR Code\n                    </button>\n                    <button class=\"flex h-14 w-full items-center justify-center gap-3 rounded-[15px] border border-[#E0E8F0] bg-white text-[15px] font-bold text-[#0D1B2A] shadow-[0_5px_14px_rgba(13,71,161,0.07)]\" data-kid=\"1-1-4-2-2-2\" data-name=\"attendance history button\">\n                        <i class=\"h-5 w-5 text-[#0D1B2A]/60\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2-2-1\" data-lucide=\"clock-3\" data-name=\"clock icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                        Attendance History\n                    </button>\n                    <button class=\"flex h-14 w-full items-center justify-center gap-3 rounded-[15px] border border-[#E0E8F0] bg-white text-[15px] font-bold text-[#0D1B2A] shadow-[0_5px_14px_rgba(13,71,161,0.07)]\" data-kid=\"1-1-4-2-2-3\" data-name=\"profile button\">\n                        <i class=\"h-5 w-5 text-[#0D1B2A]/60\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2-3-1\" data-lucide=\"user-round\" data-name=\"user icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                        Profile\n                    </button>\n                </div>\n            </div>\n            <div class=\"absolute bottom-0 left-0 right-0 border-t border-[#D7E7F6] bg-white/90 px-5 pb-7 pt-4\" data-kid=\"1-1-4-3\" data-name=\"footer action container\">\n                <button class=\"flex h-12 w-full items-center justify-center gap-2 rounded-[14px] border border-[#B8CBE2] bg-white text-[14px] font-bold text-[#1534c0]\" data-kid=\"1-1-4-3-1\" data-name=\"sign out button\">\n                    <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-4-3-1-1\" data-lucide=\"log-out\" data-name=\"logout icon\" data-reason=\"icon rendered by lucide script\">\n                    </i>\n                    Sign Out\n                </button>\n            </div>\n            <div class=\"absolute inset-0 z-20 flex items-center justify-center bg-[#0D1B2A]/45 px-5 backdrop-blur-[2px]\" data-kid=\"1-1-4-4\" data-name=\"modal overlay container\">\n                <div class=\"w-full rounded-[22px] border border-white/80 bg-white p-5 shadow-[0_18px_42px_rgba(13,27,42,0.24)]\" data-kid=\"1-1-4-4-1\" data-name=\"confirmation modal\">\n                    <div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-[#E3F2FD] text-[#1534c0]\" data-kid=\"1-1-4-4-1-1\" data-name=\"modal icon container\">\n                        <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-1-4-4-1-1-1\" data-lucide=\"log-out\" data-name=\"logout icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                    </div>\n                    <p class=\"text-[18px] font-bold tracking-[-0.02em] text-[#0D1B2A]\" data-kid=\"1-1-4-4-1-2\" data-name=\"modal title\">\n                        Sign Out\n                    </p>\n                    <p class=\"mt-2 text-[14px] leading-5 text-[#0D1B2A]/65\" data-kid=\"1-1-4-4-1-3\" data-name=\"modal description\">\n                        Are you sure you want to sign out?\n                    </p>\n                    <div class=\"mt-6 flex gap-3\" data-kid=\"1-1-4-4-1-4\" data-name=\"modal action buttons\">\n                        <button class=\"flex h-11 flex-1 items-center justify-center rounded-[13px] border border-[#E0E8F0] bg-white text-[14px] font-bold text-[#0D1B2A]\" data-kid=\"1-1-4-4-1-4-1\" data-name=\"cancel button\">\n                            Cancel\n                        </button>\n                        <button class=\"flex h-11 flex-1 items-center justify-center rounded-[13px] bg-[#1534c0] text-[14px] font-bold text-white shadow-[0_6px_14px_rgba(21,52,192,0.2)]\" data-kid=\"1-1-4-4-1-4-2\" data-name=\"confirm sign out button\">\n                            Sign Out\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </div>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();\n    </script>\n</div>\n",
